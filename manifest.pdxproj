# pdxcurl -- paideia-as build manifest
#
# Wave: R100  Milestone: Wave CC (M2/M3 real-body drain)
# Doc:  design/networking/pdxcurl-design.md +
#       design/networking/r100-user-tools-plan.md §12.3 + §13.3
#       (paideia-os repo).
#
# Consumed by `paideia-as build` (release-time signer path) and by the
# tools/build.sh iterator (`src/*.pdx` glob) at day-to-day build time.
# paideia-as v0.36.0 is the toolchain floor (see tools/build.sh); the
# release-time dual-sign at a future M5 additionally invokes
# paideia-pq-sign::sign_release_artifact (Ed25519 + ML-DSA-65 hybrid).
#
# v1.4.0 (Wave HH drain, this landing) closes:
#   - pdxcurl#8  M3-001 HTTPS path -- --trust=cap:<n> argv gate
#     (src/main.pdx curl_flag_trust_long/curl_take_trust) + a WEAK-stub
#     TlsWire::tls_wire_net_tls_wrap call (src/tls_wire.pdx) right
#     after sys_connect succeeds on an https:// request. libpdx-net
#     does not exist in-repo and this toolchain has no STB_WEAK linker
#     binding, so the stub is a real local function that always
#     returns success (request proceeds in plaintext); see
#     src/tls_wire.pdx header for the full rationale. https:// without
#     --trust= still refuses at curl_tls_not_yet, unchanged.
#   - pdxcurl#11 M3-004 --audit-only -- INTENT-only terminal path
#     (src/main.pdx curl_audit_only_path): emits the audit-INTENT
#     record (result_code=RC_AUDIT_ONLY=11) + a fd-2 fingerprint, then
#     sys_exit(EXIT_SUCCESS_AUDIT_ONLY=200) -- no TCP connect, no HTTP
#     send/recv, no semantic-pipe HRR emit.
#   - pdxcurl#13 M4-001 HTTP GET happy-path smoke vs fixture -- new
#     tests/curl_get_smoke.pdx (module CurlGetSmoke): local WEAK-stub
#     net_mock_connect/send/recv functions feed a canned 200 OK
#     response through a self-contained curl_run_request driver;
#     asserts status==200 and a 12-byte body match, writes the body to
#     fd 1. Self-contained per tools/build.sh's per-file compile-only
#     posture (test objects are never linked together or against
#     src/*.pdx).
#   - pdxcurl#17 M4-005 redirect-chain smoke -- new
#     tests/curl_redirect_matrix.pdx (module CurlRedirectMatrix): a
#     local redirect-decision engine (crm_redirect_method) asserts
#     301/302/303 downgrade POST->GET and 307/308 preserve POST across
#     five canned-response rows, plus a 10-hop cap witness
#     (crm_follow_chain) that must refuse at the 11th hop. src/main.pdx
#     itself does not follow redirects yet (redirect_count stays 0);
#     this is a fixture-vs-engine test, not a fixture-vs-src/main.pdx
#     test -- see the file header for the full rationale.
#   - pdxcurl#18 M5-001 release closer -- CHANGELOG.md [1.4.0] entry,
#     README.md refresh, release/RELEASE-1.4.0.md operator note,
#     release/manifest.pdxsig.txt refreshed to v1.4.0 (still an
#     UNSIGNED source-form placeholder pending the v0.33 PQ-signing
#     crypto landing -- "dual-signed" stays aspirational naming until
#     paideia-pq-sign::sign_release_artifact is actually invocable).
#
# v1.3.0 (Wave CC drain, previous landing) closed:
#   - pdxcurl#4  M2-001 libpdx-url integration -- inline url_parse
#     landed in src/main.pdx (http:// + IPv4 dotted-decimal +
#     optional :PORT + optional /path); scheme/ip/port/host/path
#     slots public in src/url_parse.pdx module UrlParse. libpdx-url
#     does not exist in-repo yet; a future landing swaps the inline
#     parser call-site for `libpdx_url::parse` without touching the
#     result-slot names.
#   - pdxcurl#5  M2-002 HTTP-only GET -- real sys_socket(87) +
#     sys_connect(91) + sys_send(92) + sys_recv(93) path. Response
#     parse recovers HTTP status from bytes [9..12] of the first
#     line and finds the body via "\r\n\r\n" scan. HTTPS still
#     refused (jumps to curl_tls_not_yet); pdxcurl#8 blocks on
#     libpdx-net M5.
#   - pdxcurl#6  M2-003 --output FILE -- sys_open(2) with flags
#     O_CREAT|O_WRONLY|O_TRUNC (0xC1) + mode 0644, then sys_write(1)
#     of the parsed body, then sys_close(3). Absent --output writes
#     body to fd 1 (stdout).
#   - pdxcurl#7  M2-004 --data / POST body -- --data or -d captures
#     the POST payload and triggers the POST request path (method
#     enum=1); Content-Length header decimal-encoded inline from the
#     scanner-computed data_len (u64 div-by-10 loop, LSD-first,
#     reversed on emit). Data payload capped at 1024 bytes.
#   - pdxcurl#9  M3-002 libpdx-audit INTENT+RESULT -- local audit
#     surface in src/audit_emit.pdx (module AuditEmit) plus inline
#     emits in src/main.pdx via sys_semantic_send(115) under schema
#     0x0100747541727543 ("CurAut"+01). INTENT record emitted BEFORE
#     sys_socket (result_code=RC_INTENT=12); RESULT record emitted
#     AFTER sys_recv success or from every failure branch (rc chosen
#     from src/error_taxonomy.pdx: RC_OK / RC_HTTP_4XX / RC_HTTP_5XX
#     on success, RC_CONN_REFUSED / RC_TLS_HANDSHAKE_FAILED on
#     failure). libpdx-audit does not exist in-repo yet; a future
#     landing swaps the sys_semantic_send emit for a real
#     audit_append_leaf IPC send without changing the record shape.
#
# v1.2.0 (Wave V drain, previous landing) closed:
#   - pdxcurl#1  M1-001 scaffold + caps.decl (formally closed --
#     the scaffold already landed at v1.1.0; the drain reconciles
#     the tracker with the shipped state)
#   - pdxcurl#2  M1-002 argv surface (rodata half landed at
#     src/argv_surface.pdx; parser body deferred behind libpdx-argv
#     scanner wire-in tracked separately)
#   - pdxcurl#3  M1-003 --dry-run (honest witness -- reserved
#     RC_DRY_RUN/EXIT_OK pair in src/error_taxonomy.pdx and stub
#     diagnostic slot in src/main.pdx; body follows M1-002 parser)
#   - pdxcurl#10 M3-003 semantic-pipe emit (honest witness -- v1.1-B
#     stub landed at v1.1.0; the real per-request emit needs
#     M2-002/M3-002 to fill the numeric fields; not a v1.2.0 wire)
#   - pdxcurl#12 M3-005 error taxonomy (landed at src/error_taxonomy.
#     pdx as .rodata namespace: RC_* result_code + EXIT_* exit code,
#     every failure mode a distinct pair per design-doc §7)
#
# v1.1.0 (Wave M drain, previous landing) closed:
#   - pdxcurl#14 M4-002 HTTPS happy-path smoke witness (BLOCKED)
#   - pdxcurl#15 M4-003 failure-matrix smoke witness (BLOCKED)
#   - pdxcurl#16 M4-004 audit-trail assertion witness (BLOCKED)
#   - pdxcurl#21 v1.1-B semantic-pipe emission wire
#   - pdxcurl#22 v1.1-C release closer + tag v1.1.0
#
# What v1.4.0 does NOT ship:
#   - A real TLS handshake (net_tls_wrap stays a WEAK-stub passthrough;
#     see pdxcurl#8 above). DNS-name hosts / -H headers / -X method
#     override / chunked-encoding / recv-loop for bodies > 4 KiB --
#     unchanged from v1.3.0.
#   - Argv parser BODY (pdxcurl#2 parser-side -- rodata namespace
#     landed at v1.2.0; the scan loop lands at libpdx-argv M1 unblock).
#   - --dry-run body (pdxcurl#3 -- rodata reservation only).
#   - A real redirect-follow loop in src/main.pdx (pdxcurl#17's smoke
#     tests a local decision engine, not a shipped chain-follow).
#   - Actual dual (Ed25519 + ML-DSA-65) signatures over the release
#     manifest (pdxcurl#18 -- blocked on the v0.33 PQ-signing crypto
#     landing; the manifest stays an UNSIGNED source-form placeholder).
#   - Mirror push (pdxcurl#19, M5-002).

name        = pdxcurl
version     = 1.5.0
kind        = tool
entry       = _start                    # src/main.pdx
output      = build-out/pdxcurl.elf
caps_decl   = caps.decl

# --- Source list (order-insensitive; paideia-as resolves module deps
# from `module <Basename> = structure { ... }` headers).
sources:
  - src/main.pdx                  # v1.4.0 REAL: argv scan + url parse + http
                                  # get/post + --output file + audit emit +
                                  # --trust=/--audit-only gates (Wave HH)
  - src/tool_ident.pdx            # PDX_TOOL_NAME / PDX_TOOL_VERSION (Wave 6)
  - src/error_taxonomy.pdx        # v1.2.0 Wave V (pdxcurl#12): RC_*/EXIT_* rodata
  - src/argv_surface.pdx          # v1.2.0 Wave V (pdxcurl#2):  flag-name rodata
  - src/url_parse.pdx             # v1.3.0 Wave CC (pdxcurl#4): URL constants +
                                  # shared .bss result slots (curl_url_*)
  - src/audit_emit.pdx            # v1.3.0 Wave CC (pdxcurl#9): audit schema tag
                                  # + curl_audit_record_buf (48 B .bss)
  - src/tls_wire.pdx              # v1.4.0 Wave HH (pdxcurl#8): --trust=cap:<n>
                                  # parse + WEAK-stub net_tls_wrap

# --- Library dependencies ----------------------------------------------
# pdxcurl at v1.1.0 depends on nothing outside the SC+ syscall floor
# (sysnos 1/60/115). libpdx-net / libpdx-url / libpdx-audit / pdxtrust
# integration lands at M2-M3 -- each is a manifest edit that will
# migrate this list from `deps: []` to the appropriate `deps:` list
# without touching src/*.pdx call-sites (the design-doc-final ABI is
# what src/main.pdx targets even at its STUB body).
deps: []

# --- Test targets ------------------------------------------------------
# M4 witnesses land at v1.1.0 as compile-only (`build-out/tests-*.o`
# artifacts, unlinked). Runtime round-trip proof-of-life awaits (a)
# libpdx-net M5 landing net_tls_wrap / net_connect / net_resolve; (b)
# pdxtrust M1 landing KIND_TLS_TRUST cap minting; (c) pdxcurl M3-002
# landing the libpdx-audit INTENT/RESULT wire; and (d) the paideia-os
# smoke-runner extension sequencing fixture-server + witness pairs.
tests:
  - tests/m4_002_https_smoke.pdx      # pdxcurl#14 -- HTTPS happy-path (BLOCKED)
  - tests/m4_003_failure_matrix.pdx   # pdxcurl#15 -- failure matrix (BLOCKED)
  - tests/m4_004_audit_trail.pdx      # pdxcurl#16 -- audit-trail assertion (BLOCKED)
  - tests/curl_get_smoke.pdx          # pdxcurl#13 -- GET happy-path vs fixture (mocked)
  - tests/curl_redirect_matrix.pdx    # pdxcurl#17 -- redirect method-preservation
                                       # + 10-hop cap (local decision engine)

# --- Documentation targets ---------------------------------------------
# .pdxdoc source lands at M5-001 (pdxcurl#18); v1.1.0 has no doc/
# tree per the honest-scope discipline.
docs: []

# --- Paideia-as compliance flags ---------------------------------------
# These mirror the invariants src/main.pdx is written against. A build
# under a paideia-as revision that does not honour every flag below
# should refuse fast rather than silently mis-encode.
compliance:
  - module-basename-pascal        # Module <BasenamePascalCase>, no dir prefix
  - no-test-mnemonic              # zero-check via cmp reg, 0
  - cmp-imm32-only                # cmp reg, imm <= 0x7FFFFFFF; else stage via r11
  - r11-scratch                   # r11 is not preserved across calls
  - byte-load-zero-then-mov_b     # xor rax, rax; mov_b rax, [ptr]
  - sysv-push-pop-parity          # rsp % 16 == 0 at every nested call

# --- Release policy ----------------------------------------------------
# v1.4.0 (M5-001, pdxcurl#18) refreshes release/manifest.pdxsig.txt +
# adds release/RELEASE-1.4.0.md, but the manifest STAYS an UNSIGNED
# source-form placeholder: the v0.33 PQ-signing crypto landing
# (paideia-pq-sign::sign_release_artifact, Ed25519 + ML-DSA-65 hybrid)
# is not yet invocable from this repo's tooling. "Dual-signed" in the
# issue title names the target shape, not v1.4.0's actual content.
# The v1.4.0 tag is hand-cut by main after this drain lands.
release:
  signer_author  = <unsigned-source-tag>                        # v1.4.0 is unsigned
  mirror_target  = <deferred-to-real-signing-landing>           # pdxcurl#19 mirror push
  manifest_src   = release/manifest.pdxsig.txt                  # source form (v1.4.0)
  release_notes  = release/RELEASE-1.4.0.md                     # operator note
