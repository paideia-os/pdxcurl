# pdxcurl -- paideia-as build manifest
#
# Wave: R100  Milestone: Wave V foundation-issue drain
# Doc:  design/networking/pdxcurl-design.md +
#       design/networking/r100-user-tools-plan.md §12.3 + §13.3
#       (paideia-os repo).
#
# Consumed by `paideia-as build` (release-time signer path) and by the
# tools/build.sh iterator (`src/*.pdx` glob) at day-to-day build time.
# paideia-as v0.36.0 is the toolchain floor (see tools/build.sh); the
# release-time dual-sign at a future M5 additionally invokes
# paideia-pq-sign::sign_release_artifact (Ed25519 + ML-DSA-65 hybrid).
#
# v1.2.0 (Wave V drain, this landing) closes:
#   - pdxcurl#1  M1-001 scaffold + caps.decl (formally closed --
#     the scaffold already landed at v1.1.0; the drain reconciles
#     the tracker with the shipped state)
#   - pdxcurl#2  M1-002 argv surface (rodata half landed at
#     src/argv_surface.pdx; parser body deferred behind libpdx-argv
#     scanner wire-in tracked separately)
#   - pdxcurl#3  M1-003 --dry-run (honest witness -- reserved
#     RC_DRY_RUN/EXIT_OK pair in src/error_taxonomy.pdx and stub
#     diagnostic slot in src/main.pdx; body follows M1-002 parser)
#   - pdxcurl#10 M3-003 semantic-pipe emit (honest witness -- v1.1-B
#     stub landed at v1.1.0; the real per-request emit needs
#     M2-002/M3-002 to fill the numeric fields; not a v1.2.0 wire)
#   - pdxcurl#12 M3-005 error taxonomy (landed at src/error_taxonomy.
#     pdx as .rodata namespace: RC_* result_code + EXIT_* exit code,
#     every failure mode a distinct pair per design-doc §7)
#
# v1.1.0 (Wave M drain, previous landing) closed:
#   - pdxcurl#14 M4-002 HTTPS happy-path smoke witness (BLOCKED)
#   - pdxcurl#15 M4-003 failure-matrix smoke witness (BLOCKED)
#   - pdxcurl#16 M4-004 audit-trail assertion witness (BLOCKED)
#   - pdxcurl#21 v1.1-B semantic-pipe emission wire
#   - pdxcurl#22 v1.1-C release closer + tag v1.1.0
#
# What v1.2.0 does NOT ship:
#   - Real HTTP GET / HTTPS TLS handshake / DNS resolve / audit
#     INTENT/RESULT pair (pdxcurl#5..#9, #11, #13 -- blocked on
#     libpdx-net, libpdx-url, libpdx-audit, pdxtrust satellite
#     landings).
#   - Argv parser BODY (pdxcurl#2 parser-side -- rodata namespace
#     landed here; the scan loop lands at libpdx-argv M1 unblock).
#   - Redirect-chain smoke (pdxcurl#17, M4-005).
#   - Dual-signed release manifest (pdxcurl#18, M5-001 -- v1.2.0
#     remains UNSIGNED source-tag; dual-sign target slid to v1.3.0
#     following the pdxsock precedent of collecting more drain
#     before minting hybrid signatures).

name        = pdxcurl
version     = 1.2.0
kind        = tool
entry       = _start                    # src/main.pdx
output      = build-out/pdxcurl.elf
caps_decl   = caps.decl

# --- Source list (order-insensitive; paideia-as resolves module deps
# from `module <Basename> = structure { ... }` headers).
sources:
  - src/main.pdx                  # v1.1-B: STUB entry + HttpRequestRecord emit
  - src/tool_ident.pdx            # PDX_TOOL_NAME / PDX_TOOL_VERSION (Wave 6)
  - src/error_taxonomy.pdx        # v1.2.0 Wave V (pdxcurl#12): RC_*/EXIT_* rodata
  - src/argv_surface.pdx          # v1.2.0 Wave V (pdxcurl#2):  flag-name rodata

# --- Library dependencies ----------------------------------------------
# pdxcurl at v1.1.0 depends on nothing outside the SC+ syscall floor
# (sysnos 1/60/115). libpdx-net / libpdx-url / libpdx-audit / pdxtrust
# integration lands at M2-M3 -- each is a manifest edit that will
# migrate this list from `deps: []` to the appropriate `deps:` list
# without touching src/*.pdx call-sites (the design-doc-final ABI is
# what src/main.pdx targets even at its STUB body).
deps: []

# --- Test targets ------------------------------------------------------
# M4 witnesses land at v1.1.0 as compile-only (`build-out/tests-*.o`
# artifacts, unlinked). Runtime round-trip proof-of-life awaits (a)
# libpdx-net M5 landing net_tls_wrap / net_connect / net_resolve; (b)
# pdxtrust M1 landing KIND_TLS_TRUST cap minting; (c) pdxcurl M3-002
# landing the libpdx-audit INTENT/RESULT wire; and (d) the paideia-os
# smoke-runner extension sequencing fixture-server + witness pairs.
tests:
  - tests/m4_002_https_smoke.pdx      # pdxcurl#14 -- HTTPS happy-path (BLOCKED)
  - tests/m4_003_failure_matrix.pdx   # pdxcurl#15 -- failure matrix (BLOCKED)
  - tests/m4_004_audit_trail.pdx      # pdxcurl#16 -- audit-trail assertion (BLOCKED)

# --- Documentation targets ---------------------------------------------
# .pdxdoc source lands at M5-001 (pdxcurl#18); v1.1.0 has no doc/
# tree per the honest-scope discipline.
docs: []

# --- Paideia-as compliance flags ---------------------------------------
# These mirror the invariants src/main.pdx is written against. A build
# under a paideia-as revision that does not honour every flag below
# should refuse fast rather than silently mis-encode.
compliance:
  - module-basename-pascal        # Module <BasenamePascalCase>, no dir prefix
  - no-test-mnemonic              # zero-check via cmp reg, 0
  - cmp-imm32-only                # cmp reg, imm <= 0x7FFFFFFF; else stage via r11
  - r11-scratch                   # r11 is not preserved across calls
  - byte-load-zero-then-mov_b     # xor rax, rax; mov_b rax, [ptr]
  - sysv-push-pop-parity          # rsp % 16 == 0 at every nested call

# --- Release policy ----------------------------------------------------
# v1.1.0 is the unsigned source-tag release (Wave M drain: pdxcurl#22).
# Dual-signed release-source landing lands at v1.2.0 (M5-001 /
# pdxcurl#18), following the pdxsock precedent. The v1.1.0 tag is
# hand-cut by main after this drain lands.
release:
  signer_author  = <unsigned-source-tag>                        # v1.1.0 is unsigned
  mirror_target  = <deferred-to-v1.2.0-M5-001>                  # pdxcurl#19 mirror push
  manifest_src   = release/manifest.pdxsig.txt                  # source form (v1.1.0)
  release_notes  = release/RELEASE-1.1.0.md                     # operator note
