// src/main.pdx -- pdxcurl v1.4.0 REAL M2/M3 body (Wave CC) + Wave HH
//                  M3-001 --trust= gate / net_tls_wrap wiring +
//                  M3-004 --audit-only INTENT-only path.
//
// v1.3.0 lands the M2/M3 real bodies for:
//   pdxcurl#4  M2-001 libpdx-url integration    (inline url_parse; libpdx-url
//                                                 not yet in repo -- see
//                                                 src/url_parse.pdx header)
//   pdxcurl#5  M2-002 HTTP GET (no TLS)         (sys_socket + sys_connect +
//                                                 sys_send + sys_recv)
//   pdxcurl#6  M2-003 --output FILE             (sys_open O_CREAT|O_WRONLY|
//                                                 O_TRUNC + sys_write)
//   pdxcurl#7  M2-004 --data / POST body        (POST request line +
//                                                 Content-Length header)
//   pdxcurl#9  M3-002 libpdx-audit INTENT/RESULT (sys_semantic_send under
//                                                 curl_schema_audit tag;
//                                                 INTENT emitted before
//                                                 sys_connect, RESULT
//                                                 emitted after sys_recv
//                                                 or from a failure branch)
//
// The v1.1-B M3-003 HttpRequestRecord@0.1 pipe emit (schema 0x487474
// 7052657101 = "HttpReq"+01) is preserved: still emitted at the END
// of every completed request with the response numeric fields filled
// in. Consumers of the pipe stream that were parsing v1.1-B records
// keep parsing v1.3.0 records against the same schema tag; the shape
// is unchanged, only the field VALUES become real.
//
// v1.4.0 Wave HH additions (pdxcurl#8, pdxcurl#11)
// -------------------------------------------------
//   - TLS / https:// (pdxcurl#8, M3-001): https:// is refused UNLESS
//     the argv scan captured a `--trust=cap:<n>` token (parsed inline
//     in Phase A; see curl_flag_trust_long / curl_take_trust below).
//     With a trust token present, Phase C.1 calls
//     TlsWire::tls_wire_net_tls_wrap(sock_fd, trust_cap_n, host_ptr,
//     host_len) (src/tls_wire.pdx) right after sys_connect succeeds.
//     tls_wire_net_tls_wrap is a WEAK STUB (this toolchain has no
//     STB_WEAK binding -- see src/tls_wire.pdx header): it always
//     returns 0 (success-passthrough), so the request proceeds in
//     plaintext over the raw TCP socket rather than performing a real
//     TLS handshake. This is a wiring landing, not a real handshake --
//     KIND_TLS_TRUST cap minting still blocks on pdxtrust M1 (caps.decl
//     keeps KIND_TLS_TRUST optional pending that landing) and a real
//     handshake blocks on libpdx-net M5. https:// WITHOUT --trust=
//     still refuses at curl_tls_not_yet (exit EXIT_TLS_HANDSHAKE_
//     FAILED=9), unchanged from v1.3.0.
//   - --audit-only (pdxcurl#11, M3-004): when the argv scan captures
//     the bare `--audit-only` flag, Phase B.4 short-circuits directly
//     from curl_url_parse_ok to curl_audit_only_path: an INTENT
//     HttpRequestRecord@0.1 (result_code=RC_AUDIT_ONLY=11) is emitted
//     to the audit sink (sys_semantic_send, schema=curl_schema_audit)
//     AND a human-readable fingerprint is written to fd 2, then
//     sys_exit(EXIT_SUCCESS_AUDIT_ONLY=200) -- a distinct exit status
//     from the ordinary success path (0) so a caller can tell an
//     audit-only run apart from a completed request without parsing
//     the audit stream. No sys_socket/connect/send/recv and no
//     semantic-pipe HttpRequestRecord@0.1 (that stream is reserved for
//     completed requests per M3-003's contract) run on this path.
//
// What v1.4.0 still does NOT land
// --------------------------------
//   - A real TLS handshake (net_tls_wrap stays a passthrough stub;
//     see above). DNS-name hosts. Only IPv4 dotted-decimal (a.b.c.d)
//     accepted; a non-numeric host jumps to curl_url_bad (exit
//     EXIT_ARGV_USAGE=2). Blocks on a user-space DNS syscall landing.
//   - -H / --header -- accepted at the argv scanner but the
//     header-list is not marshalled into the request assembly.
//   - -X / --method with GET/POST alternatives (HEAD/PUT/DELETE)
//     (pdxcurl scope: v1.4.0 handles POST when --data present, GET
//     otherwise; -X override to force PUT/DELETE deferred).
//   - --dry-run (pdxcurl#3) -- flag literal in src/argv_surface.pdx
//     honoured by the scanner but the flag-body branch is STUB (write
//     reserved diagnostic + exit 0). RC_DRY_RUN emits an audit-INTENT
//     record but no network I/O.
//   - Response body > 4096 bytes. Single sys_recv into a 4 KiB
//     scratch; a larger body is truncated to 4 KiB and the request
//     succeeds with body_bytes = 4096 in the RESULT record. A
//     recv-loop landing tracked as a follow-up.
//   - Chunked-encoding (Transfer-Encoding: chunked). Parser scans
//     the first "\r\n\r\n" and copies everything after to the output
//     fd verbatim; if the server responded with chunked framing,
//     the output includes the chunk-size lines. HTTP/1.0 in the
//     request-line suppresses this in most stacks.
//
// CLI surface honoured at v1.4.0
// ------------------------------
//   pdxcurl [ -o | --output FILE ] [ -d | --data BODY ]
//           [ --trust=cap:<n> ] [ --audit-only ] <url>
//
// Positional <url> is REQUIRED; if absent (or if the scanner
// completes without capturing one), exit EXIT_ARGV_USAGE (=2).
// `--trust=cap:<n>` and `--audit-only` are each single-token flags
// (no following argv slot consumed), unlike `-o`/`-d` which each
// consume the NEXT argv slot as their value.
//
// Register plan (across the four phases of _start)
// ------------------------------------------------
// Phase A (argv scan):   r12 = argc, r13 = argv base, rbx = i (cursor),
//                        r14 = current argv[i] ptr, r15 = scratch
// Phase B (url parse):   r12/r13 unused (state persists in .bss slots).
//                        r15 = byte cursor into argv[url]. rax = per-
//                        byte scratch. r8 = per-field octet accumulator.
//                        rdx = folded ip u32. r11 = dot count.
// Phase C (request):     rbp = ip u32 (from curl_url_ip), rbx = port,
//                        r14 = method (0=GET, 1=POST), r15 = socket fd,
//                        r12 = req_len (accumulator into curl_req_buf)
// Phase D (response):    r12 = bytes recv'd (from sys_recv return),
//                        r13 = HTTP status (parsed from response),
//                        r15 = output fd (socket-fd flipped to file-fd
//                        after sys_open when --output present; else 1)
//
// SC+ IDs used
// ------------
//     1 = sys_write         (fd, buf, count)
//     2 = sys_open          (path_va, flags, mode)     [O_CREAT|O_WRONLY
//                                                        |O_TRUNC = 0xC1]
//     3 = sys_close         (fd)
//    60 = sys_exit          (status)
//    87 = sys_socket        (domain, type, proto)
//    91 = sys_connect       (fd, remote_ip, remote_port)
//    92 = sys_send          (fd, buf, len)
//    93 = sys_recv          (fd, buf, len)
//   115 = sys_semantic_send (schema, rec_ptr, rec_len)
//
// Encoder discipline (paideia-as 0.36+ pitfalls, per user memory)
// ---------------------------------------------------------------
//   - No `test rN, rN`. Every zero-check is `cmp rN, 0`.
//   - No 2-op `imul r, imm`. Decimal *10 is `shl rax, 3; add rax, r10;
//     add rax, r10` (pdxsock precedent at pdxsock_port_loop).
//   - Byte loads: `xor rax, rax; mov_b rax, [ptr]`.
//   - Every label prefixed `curl_`.
//   - Module name PascalCase basename (Main).
//   - No `and r11, imm64`; every mask fits in imm32.
//   - Length constants for wire strings are separate `_len` u64 slots
//     (excludes trailing NUL); source arrays include NUL.
//   - No multi-line `pub let = "..."` continuations.

module Main = structure {

  // ==================================================================
  // Diagnostic strings (fd 2 targets; wire byte counts exclude NUL)
  // ==================================================================
  pub let curl_msg_usage             : [u8; 48] = "pdxcurl: usage: pdxcurl [-o F] [-d BODY] <url>\n\0"
  pub let curl_msg_usage_len         : u64      = 47

  pub let curl_msg_bad_url           : [u8; 33] = "pdxcurl: bad url (want http://)\n\0"
  pub let curl_msg_bad_url_len       : u64      = 32

  pub let curl_msg_bad_ip            : [u8; 38] = "pdxcurl: bad host (want IPv4 dotted)\n\0"
  pub let curl_msg_bad_ip_len        : u64      = 37

  pub let curl_msg_tls_not_yet       : [u8; 39] = "pdxcurl: https:// not wired at v1.3.0\n\0"
  pub let curl_msg_tls_not_yet_len   : u64      = 38

  pub let curl_msg_socket_fail       : [u8; 24] = "pdxcurl: socket failed\n\0"
  pub let curl_msg_socket_fail_len   : u64      = 23

  pub let curl_msg_connect_fail      : [u8; 25] = "pdxcurl: connect failed\n\0"
  pub let curl_msg_connect_fail_len  : u64      = 24

  pub let curl_msg_send_fail         : [u8; 22] = "pdxcurl: send failed\n\0"
  pub let curl_msg_send_fail_len     : u64      = 21

  pub let curl_msg_recv_fail         : [u8; 22] = "pdxcurl: recv failed\n\0"
  pub let curl_msg_recv_fail_len     : u64      = 21

  pub let curl_msg_open_fail         : [u8; 27] = "pdxcurl: open output fail\n\0"
  pub let curl_msg_open_fail_len     : u64      = 26

  pub let curl_msg_bad_resp          : [u8; 34] = "pdxcurl: malformed HTTP response\n\0"
  pub let curl_msg_bad_resp_len      : u64      = 33

  pub let curl_msg_dry_run_stub      : [u8; 40] = "pdxcurl: --dry-run, no network I/O run\n\0"
  pub let curl_msg_dry_run_stub_len  : u64      = 39

  pub let curl_msg_audit_only        : [u8; 47] = "pdxcurl: --audit-only, INTENT emitted, no I/O\n\0"
  pub let curl_msg_audit_only_len    : u64      = 46

  pub let curl_msg_tls_wrap_fail     : [u8; 26] = "pdxcurl: tls wrap failed\n\0"
  pub let curl_msg_tls_wrap_fail_len : u64      = 25

  // ==================================================================
  // Fixed request-line + header fragments (assembled into curl_req_buf)
  // ==================================================================
  pub let curl_frag_get              : [u8; 5]  = "GET \0"
  pub let curl_frag_get_len          : u64      = 4
  pub let curl_frag_post             : [u8; 6]  = "POST \0"
  pub let curl_frag_post_len         : u64      = 5
  pub let curl_frag_http10           : [u8; 12] = " HTTP/1.0\r\n\0"
  pub let curl_frag_http10_len       : u64      = 11
  pub let curl_frag_host             : [u8; 7]  = "Host: \0"
  pub let curl_frag_host_len         : u64      = 6
  pub let curl_frag_crlf             : [u8; 3]  = "\r\n\0"
  pub let curl_frag_crlf_len         : u64      = 2
  pub let curl_frag_clen             : [u8; 17] = "Content-Length: \0"
  pub let curl_frag_clen_len         : u64      = 16

  // ==================================================================
  // .bss scratch buffers
  // ==================================================================
  //   curl_req_buf    -- outbound HTTP request assembly (2 KiB cap; path
  //                       + host + method + headers + POST body).
  //   curl_resp_buf   -- inbound HTTP response (4 KiB cap; single
  //                       sys_recv, MVP -- see file header).
  //   curl_clen_buf   -- decimal-encoded Content-Length ASCII (20 bytes:
  //                       max u64 = 20 digits).
  //   curl_argv_slots -- captured argv pointers from Phase A scan:
  //                       [+0]  = url_ptr        (0 = unset)
  //                       [+8]  = output_ptr     (0 = stdout)
  //                       [+16] = data_ptr       (0 = GET; nonzero = POST)
  //                       [+24] = data_len       (u64; strlen at scan-time)
  //                       [+32] = trust_present  (0/1; pdxcurl#8 --trust=)
  //                       [+40] = trust_cap_n    (u64; parsed cap:<n> value)
  //                       [+48] = audit_only     (0/1; pdxcurl#11 --audit-only)
  // ==================================================================
  pub let mut curl_req_buf           : [u8; 2048] = uninit @align(8)
  pub let mut curl_resp_buf          : [u8; 4096] = uninit @align(8)
  pub let mut curl_clen_buf          : [u8; 24]   = uninit @align(8)
  pub let mut curl_argv_slots        : [u8; 56]   = uninit @align(8)

  // v1.1-B semantic-pipe record buffer + schema constants (pipe stream)
  pub let mut curl_record_buf        : [u8; 48]   = uninit @align(8)
  pub let curl_schema_http_req       : u64        = 0x4874747052657101
  pub let curl_hrr_magic             : u64        = 0x4C5255434B584450

  // ==================================================================
  // _start -- pdxcurl entry point. Never returns; every terminal path
  // ends in sys_exit.
  //
  // Effects: {mem, sysreg} for scratch + every SYSCALL.
  // Caps:    @{fs, sched, cap}
  // ==================================================================
  pub let _start : () -> () !{mem, sysreg} @{fs, sched, cap} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched, cap},
      justification: "pdxcurl v1.3.0 REAL M2/M3 body (Wave CC: pdxcurl#4, #5, #6, #7, #9). Retires the v1.2.0 argv-refusing STUB entry with a real HTTP-only driver that (a) walks argv[1..argc-1] recognising -o/--output FILE and -d/--data BODY plus a single positional <url> (argc cap 32, one --output slot, one --data slot); (b) parses the URL inline via curl_url_parse_inline (http:// prefix + IPv4 dotted-decimal host [a.b.c.d, 0..255 each] + optional :PORT slug + optional /path slug), writing scheme/ip/port/host_ptr/host_len/path_ptr/path_len into the .bss slots UrlParse.curl_url_* declared in src/url_parse.pdx; a https:// URL is parsed to scheme=1 but the request-path branch jumps to curl_tls_not_yet (exit EXIT_TLS_HANDSHAKE_FAILED=9) since M3-001/pdxcurl#8 is not yet wired; a non-numeric host jumps to curl_url_bad (exit EXIT_ARGV_USAGE=2) since a user-space DNS syscall is not yet available; (c) emits an audit-INTENT HttpRequestRecord@0.1 record (schema 0x0100747541727543 = 'CurAut'+01, result_code=RC_INTENT=12, method_and_scheme filled from r14+scheme, all other numeric fields zero) via sys_semantic_send BEFORE the sys_socket call, satisfying pdxcurl#9 M3-002's INTENT-before-DNS requirement; (d) calls sys_socket(AF_INET=2, SOCK_STREAM=1, 0) and sys_connect(fd, ip, port) with the parsed peer coords, jumping to curl_socket_fail / curl_connect_fail on any negative return; (e) assembles the outbound HTTP request into curl_req_buf via inline byte-copy loops -- request line ('GET '/'POST ' + path + ' HTTP/1.0\\r\\n'), Host header ('Host: ' + host + '\\r\\n'), optionally Content-Length header ('Content-Length: ' + decimal-ASCII(data_len) + '\\r\\n') and the final terminating '\\r\\n', then the POST body when curl_argv_slots+16 != 0 -- with req_len (r12) tracking the total wire byte count; (f) sys_send(fd, curl_req_buf, req_len); (g) single sys_recv into curl_resp_buf (4 KiB cap; a truncated read is an honest MVP scope call per file header), r12 = bytes_recv'd; (h) parses HTTP status from response bytes [9..12] as three ASCII decimal digits (rejects anything not matching HTTP/1.X SSS shape via curl_bad_resp exit=EXIT_ARGV_USAGE), r13 = status; (i) scans response for the '\\r\\n\\r\\n' end-of-headers sentinel and reads back body_start_offset + body_len; (j) if curl_argv_slots+8 != 0 sys_open(path, O_CREAT|O_WRONLY|O_TRUNC=0xC1, mode=0644) for the output file (fd -> r15) else r15 = 1 (stdout); (k) sys_write(r15, body_ptr, body_len) then sys_close(r15) if r15 != 1 and always sys_close(socket_fd); (l) emits an audit-RESULT HttpRequestRecord@0.1 record with method_and_scheme + status + body_bytes filled in and result_code = RC_OK / RC_HTTP_4XX (status >= 400 && < 500) / RC_HTTP_5XX (status >= 500 && < 600); (m) emits the pipe HttpRequestRecord@0.1 record under schema 'HttpReq'+01 unchanged from v1.1-B shape (all fields now real, not just leading magic); (n) sys_exit with the design-doc §7 exit code -- 0 on 2xx, EXIT_HTTP_4XX=4 on 4xx, EXIT_HTTP_5XX=5 on 5xx. Every syscall failure has its own diagnostic on fd 2 and a distinct nonzero exit status (EXIT_CONN_REFUSED=7 for sys_connect fail, EXIT_ARGV_USAGE=2 for scanner refusal, EXIT_TLS_HANDSHAKE_FAILED=9 for https not-wired, etc.) and an audit-RESULT record with the matching RC_* result_code. The two audit records travel under distinct schema tags from the pipe record so a consumer parsing sys_semantic_send's ring by schema can dispatch cleanly. Register discipline: r12/r13/rbx/rbp/r14/r15 all callee-save; roles switch across the four phases (see file-header §Register plan). r12 and r13 flip from argc/argv (Phase A) to req_len (Phase C) to bytes_recv / status (Phase D). rbx flips from scan-cursor (Phase A) to port (Phase C). rbp holds ip u32 across Phase C/D. All state carried in callee-save registers survives every SYSCALL by the amd64 fast-syscall convention (rcx and r11 are SYSCALL-clobbered per that convention; the byte-copy inner loops use them for cursor scratch only, never reading them after a syscall). sys_semantic_send returns are intentionally discarded (marshalling errors are compile-time gated -- 48-byte record within [1,240] cap, static rip-relative record_ptr never fails user_ptr_ok). Encoder discipline: no `test rN, rN` (every zero-check is `cmp rN, 0`); no 2-op `imul r, imm` (decimal *10 is `shl rax, 3; add rax, r10; add rax, r10` per pdxsock_port_loop; decimal encode for Content-Length divides by 10 via `mov r10, 10; xor rdx, rdx; div r10` -- one-op div r64 is safe); byte loads use `xor rax, rax; mov_b rax, [ptr]`; module basename PascalCase (Main); every label prefixed `curl_`; every fingerprint string carries an explicit `_len` sibling. No `and r11, imm64`; every mask fits in imm32 (0xC1, 0xFF, 0xFFFF). Multi-line string literals absent -- every rodata literal is single-line. sys_open flags = 0x40 (O_CREAT) | 0x01 (O_WRONLY) | 0x80 (O_TRUNC) = 0xC1; vfs_open honours O_CREAT bit-6 for creation and ignores the access-mode bits at R16.M3 per src/kernel/core/fs/vfs_open.pdx header, so 0xC1 is a superset of the currently-honoured shape and a future O_WRONLY/O_TRUNC enforcement landing works as-is. Wave HH (pdxcurl#8, pdxcurl#11) additions: Phase B.4 (at curl_url_parse_ok) checks curl_argv_slots+48 (audit_only, set by curl_take_audit on a bare `--audit-only` token) before the https/trust gate; when set it diverts to curl_audit_only_path, an INTENT-only terminal branch that determines method, marshals + emits the audit record (result_code=RC_AUDIT_ONLY=11) via sys_semantic_send, writes a fd-2 fingerprint, and sys_exits EXIT_SUCCESS_AUDIT_ONLY=200 without touching sys_socket/connect/send/recv or the semantic-pipe HRR emit. Phase B.4's https gate now requires curl_argv_slots+32 (trust_present, set by curl_take_trust from a `--trust=cap:<n>` token whose tail is parsed by TlsWire::tls_wire_parse_cap_uri in src/tls_wire.pdx) before letting an https:// URL past curl_url_parse_ok into curl_method_determine; Phase C.1.5, immediately after a successful sys_connect, then calls TlsWire::tls_wire_net_tls_wrap(sock_fd, trust_cap_n, host_ptr, host_len) -- a WEAK-stub function (this toolchain exposes no STB_WEAK binding, per libpdx-argv's version_backend.pdx precedent; see src/tls_wire.pdx header) that always returns 0 (success-passthrough), so the request proceeds unencrypted over the raw socket rather than performing a real handshake, and curl_tls_wrap_fail (RC_TLS_HANDSHAKE_FAILED=4 / EXIT_TLS_HANDSHAKE_FAILED=9) stays unreachable until a real net_tls_wrap lands at a future libpdx-net M5 unblock. https:// without a --trust= token is unchanged from v1.3.0 (curl_tls_not_yet, exit 9).",
      block: {

        // ============================================================
        // Phase A: argv scan
        // ============================================================
        // r12 = argc, r13 = argv base, rbx = cursor (starts at 1).
        // curl_argv_slots is written as we find slots.
        //   +0  url_ptr, +8 output_ptr, +16 data_ptr, +24 data_len,
        //   +32 trust_present, +40 trust_cap_n, +48 audit_only
        // Zero the slots first (seven u64 stores).
        mov r12, rdi;                              // argc
        mov r13, rsi;                              // argv
        lea r14, [rip + curl_argv_slots];
        xor rax, rax;
        mov [r14 + 0], rax;
        mov [r14 + 8], rax;
        mov [r14 + 16], rax;
        mov [r14 + 24], rax;
        mov [r14 + 32], rax;
        mov [r14 + 40], rax;
        mov [r14 + 48], rax;

        // Argc gate: minimum 2 (pdxcurl <url>); maximum 32.
        cmp r12, 2;
        jl curl_usage;
        cmp r12, 32;
        ja curl_usage;

        mov rbx, 1;                                // i = 1 (skip argv[0])

      curl_scan_loop:
        cmp rbx, r12;
        jae curl_scan_done;
        // r14 = argv[i] pointer
        mov r15, rbx;
        shl r15, 3;                                // i * 8
        mov r14, [r13 + r15*1];                    // r14 = argv[i]

        // Peek first byte.
        xor rax, rax;
        mov_b rax, [r14 + 0];
        cmp rax, 0x2d;                             // '-'
        jne curl_scan_positional;

        // Flag path: could be -o, -d, --output, --data.
        // Short forms first.
        xor rax, rax;
        mov_b rax, [r14 + 1];
        cmp rax, 0x6f;                             // 'o' -> -o
        je curl_flag_output_short;
        cmp rax, 0x64;                             // 'd' -> -d
        je curl_flag_data_short;
        cmp rax, 0x2d;                             // '-' -> long form
        jne curl_usage;

        // Long form: peek bytes 2..
        xor rax, rax;
        mov_b rax, [r14 + 2];
        cmp rax, 0x6f;                             // 'o' -> --output
        je curl_flag_output_long;
        cmp rax, 0x64;                             // 'd' -> --data
        je curl_flag_data_long;
        cmp rax, 0x74;                             // 't' -> --trust=
        je curl_flag_trust_long;
        cmp rax, 0x61;                             // 'a' -> --audit-only
        je curl_flag_audit_long;
        jmp curl_usage;

      curl_flag_output_short:
        // "-o" -- confirm NUL at byte 2.
        xor rax, rax;
        mov_b rax, [r14 + 2];
        cmp rax, 0;
        jne curl_usage;
        jmp curl_take_output;

      curl_flag_output_long:
        // "--output" -- confirm remaining bytes: 'u','t','p','u','t','\0'.
        xor rax, rax;
        mov_b rax, [r14 + 3];
        cmp rax, 0x75;                             // 'u'
        jne curl_usage;
        xor rax, rax;
        mov_b rax, [r14 + 4];
        cmp rax, 0x74;                             // 't'
        jne curl_usage;
        xor rax, rax;
        mov_b rax, [r14 + 5];
        cmp rax, 0x70;                             // 'p'
        jne curl_usage;
        xor rax, rax;
        mov_b rax, [r14 + 6];
        cmp rax, 0x75;                             // 'u'
        jne curl_usage;
        xor rax, rax;
        mov_b rax, [r14 + 7];
        cmp rax, 0x74;                             // 't'
        jne curl_usage;
        xor rax, rax;
        mov_b rax, [r14 + 8];
        cmp rax, 0;
        jne curl_usage;
        jmp curl_take_output;

      curl_take_output:
        // Consume next argv slot as the output path.
        add rbx, 1;
        cmp rbx, r12;
        jae curl_usage;                            // missing value
        mov r15, rbx;
        shl r15, 3;
        mov rax, [r13 + r15*1];                    // argv[i+1]
        lea r15, [rip + curl_argv_slots];
        // Refuse duplicate --output.
        mov r8, [r15 + 8];
        cmp r8, 0;
        jne curl_usage;
        mov [r15 + 8], rax;                        // slot[+8] = output_ptr
        add rbx, 1;
        jmp curl_scan_loop;

      curl_flag_data_short:
        // "-d" -- confirm NUL at byte 2.
        xor rax, rax;
        mov_b rax, [r14 + 2];
        cmp rax, 0;
        jne curl_usage;
        jmp curl_take_data;

      curl_flag_data_long:
        // "--data" -- confirm 'a','t','a','\0'.
        xor rax, rax;
        mov_b rax, [r14 + 3];
        cmp rax, 0x61;                             // 'a'
        jne curl_usage;
        xor rax, rax;
        mov_b rax, [r14 + 4];
        cmp rax, 0x74;                             // 't'
        jne curl_usage;
        xor rax, rax;
        mov_b rax, [r14 + 5];
        cmp rax, 0x61;                             // 'a'
        jne curl_usage;
        xor rax, rax;
        mov_b rax, [r14 + 6];
        cmp rax, 0;
        jne curl_usage;
        jmp curl_take_data;

      curl_take_data:
        // Consume next argv slot as the POST body.
        add rbx, 1;
        cmp rbx, r12;
        jae curl_usage;
        mov r15, rbx;
        shl r15, 3;
        mov rax, [r13 + r15*1];                    // argv[i+1]
        lea r15, [rip + curl_argv_slots];
        mov r8, [r15 + 16];
        cmp r8, 0;
        jne curl_usage;
        mov [r15 + 16], rax;                       // slot[+16] = data_ptr
        // strlen inline: walk until NUL, cap at 1024.
        xor rcx, rcx;
      curl_data_strlen_loop:
        xor r8, r8;
        mov_b r8, [rax + rcx*1];
        cmp r8, 0;
        je curl_data_strlen_done;
        add rcx, 1;
        cmp rcx, 1024;
        ja curl_usage;                             // body too big
        jmp curl_data_strlen_loop;
      curl_data_strlen_done:
        mov [r15 + 24], rcx;                       // slot[+24] = data_len
        add rbx, 1;
        jmp curl_scan_loop;

      curl_flag_trust_long:
        // "--trust=" -- confirm remaining bytes: 'r','u','s','t','='.
        xor rax, rax;
        mov_b rax, [r14 + 3];
        cmp rax, 0x72;                             // 'r'
        jne curl_usage;
        xor rax, rax;
        mov_b rax, [r14 + 4];
        cmp rax, 0x75;                             // 'u'
        jne curl_usage;
        xor rax, rax;
        mov_b rax, [r14 + 5];
        cmp rax, 0x73;                             // 's'
        jne curl_usage;
        xor rax, rax;
        mov_b rax, [r14 + 6];
        cmp rax, 0x74;                             // 't'
        jne curl_usage;
        xor rax, rax;
        mov_b rax, [r14 + 7];
        cmp rax, 0x3d;                             // '='
        jne curl_usage;
        jmp curl_take_trust;

      curl_take_trust:
        // Single-token flag -- no following argv slot consumed. Refuse
        // duplicate --trust=. Parse "cap:<n>" starting at r14+8 via
        // TlsWire::tls_wire_parse_cap_uri (src/tls_wire.pdx, pdxcurl#8).
        lea r15, [rip + curl_argv_slots];
        mov r8, [r15 + 32];
        cmp r8, 0;
        jne curl_usage;
        mov rdi, r14;
        add rdi, 8;
        call tls_wire_parse_cap_uri;
        // rax == all-ones (u64::MAX) on malformed "cap:<n>" -- computed
        // via xor+sub rather than a 64-bit immediate compare.
        xor r9, r9;
        sub r9, 1;                                 // r9 = 0xFFFF...FFFF
        cmp rax, r9;
        je curl_usage;
        lea r15, [rip + curl_argv_slots];
        mov [r15 + 40], rax;                       // trust_cap_n
        mov r9, 1;
        mov [r15 + 32], r9;                        // trust_present = 1
        add rbx, 1;
        jmp curl_scan_loop;

      curl_flag_audit_long:
        // "--audit-only" -- confirm remaining bytes:
        // 'u','d','i','t','-','o','n','l','y','\0'.
        xor rax, rax;
        mov_b rax, [r14 + 3];
        cmp rax, 0x75;                             // 'u'
        jne curl_usage;
        xor rax, rax;
        mov_b rax, [r14 + 4];
        cmp rax, 0x64;                             // 'd'
        jne curl_usage;
        xor rax, rax;
        mov_b rax, [r14 + 5];
        cmp rax, 0x69;                             // 'i'
        jne curl_usage;
        xor rax, rax;
        mov_b rax, [r14 + 6];
        cmp rax, 0x74;                             // 't'
        jne curl_usage;
        xor rax, rax;
        mov_b rax, [r14 + 7];
        cmp rax, 0x2d;                             // '-'
        jne curl_usage;
        xor rax, rax;
        mov_b rax, [r14 + 8];
        cmp rax, 0x6f;                             // 'o'
        jne curl_usage;
        xor rax, rax;
        mov_b rax, [r14 + 9];
        cmp rax, 0x6e;                             // 'n'
        jne curl_usage;
        xor rax, rax;
        mov_b rax, [r14 + 10];
        cmp rax, 0x6c;                             // 'l'
        jne curl_usage;
        xor rax, rax;
        mov_b rax, [r14 + 11];
        cmp rax, 0x79;                             // 'y'
        jne curl_usage;
        xor rax, rax;
        mov_b rax, [r14 + 12];
        cmp rax, 0;                                // '\0'
        jne curl_usage;
        jmp curl_take_audit;

      curl_take_audit:
        // Single-token flag -- no following argv slot consumed. Refuse
        // duplicate --audit-only.
        lea r15, [rip + curl_argv_slots];
        mov r8, [r15 + 48];
        cmp r8, 0;
        jne curl_usage;
        mov r9, 1;
        mov [r15 + 48], r9;                        // audit_only = 1
        add rbx, 1;
        jmp curl_scan_loop;

      curl_scan_positional:
        // Positional -- must be the single <url>. Refuse duplicate.
        lea r15, [rip + curl_argv_slots];
        mov r8, [r15 + 0];
        cmp r8, 0;
        jne curl_usage;
        mov [r15 + 0], r14;                        // slot[+0] = url_ptr
        add rbx, 1;
        jmp curl_scan_loop;

      curl_scan_done:
        // Require <url>.
        lea r15, [rip + curl_argv_slots];
        mov rax, [r15 + 0];
        cmp rax, 0;
        je curl_usage;

        // ============================================================
        // Phase B: URL parse (inline curl_url_parse_inline)
        // ============================================================
        // rax = url_ptr from Phase A.
        // Expect "http://" (7 bytes) or "https://" (8 bytes).
        // Store scheme (0 or 1) in UrlParse.curl_url_scheme.
        xor r8, r8;
        mov_b r8, [rax + 0];
        cmp r8, 0x68;                              // 'h'
        jne curl_url_bad;
        xor r8, r8;
        mov_b r8, [rax + 1];
        cmp r8, 0x74;                              // 't'
        jne curl_url_bad;
        xor r8, r8;
        mov_b r8, [rax + 2];
        cmp r8, 0x74;                              // 't'
        jne curl_url_bad;
        xor r8, r8;
        mov_b r8, [rax + 3];
        cmp r8, 0x70;                              // 'p'
        jne curl_url_bad;
        // byte 4 = 's' (https) OR ':' (http).
        xor r8, r8;
        mov_b r8, [rax + 4];
        cmp r8, 0x3a;                              // ':'
        je curl_url_scheme_http;
        cmp r8, 0x73;                              // 's'
        jne curl_url_bad;
        // https:// -- check byte 5..7 = "://" and byte 8 host-start
        xor r8, r8;
        mov_b r8, [rax + 5];
        cmp r8, 0x3a;                              // ':'
        jne curl_url_bad;
        xor r8, r8;
        mov_b r8, [rax + 6];
        cmp r8, 0x2f;                              // '/'
        jne curl_url_bad;
        xor r8, r8;
        mov_b r8, [rax + 7];
        cmp r8, 0x2f;                              // '/'
        jne curl_url_bad;
        // Scheme = HTTPS. Host cursor = 8.
        mov r9, 1;                                 // scheme = 1
        mov r15, 8;                                // host cursor
        jmp curl_url_after_scheme;

      curl_url_scheme_http:
        // byte 5 = '/', byte 6 = '/'.
        xor r8, r8;
        mov_b r8, [rax + 5];
        cmp r8, 0x2f;                              // '/'
        jne curl_url_bad;
        xor r8, r8;
        mov_b r8, [rax + 6];
        cmp r8, 0x2f;                              // '/'
        jne curl_url_bad;
        xor r9, r9;                                // scheme = 0
        mov r15, 7;                                // host cursor

      curl_url_after_scheme:
        // Stash scheme.
        mov [rip + curl_url_scheme], r9;

        // Remember host start (argv[url] + r15).
        mov r8, rax;
        add r8, r15;
        mov [rip + curl_url_host_ptr], r8;

        // Parse IPv4 dotted-decimal (a.b.c.d).
        // rdx = folded u32 (MSB-first), r11 = dot count, rcx = current
        // byte cursor into argv (rcx = r15 at entry), rdi = per-field
        // digit accum, r10 = per-field digit count. rbx repurposed as
        // ip-parse scratch until Phase C sets it to port.
        mov rcx, r15;                              // rcx = cursor
        xor rdx, rdx;                              // rdx = folded u32
        xor r11, r11;                              // r11 = dot count
      curl_ip_field:
        xor rdi, rdi;                              // per-field acc
        xor r10, r10;                              // per-field digit count
      curl_ip_digit_loop:
        xor r8, r8;
        mov_b r8, [rax + rcx*1];
        cmp r8, 0;                                 // NUL
        je curl_ip_field_end;
        cmp r8, 0x3a;                              // ':' -- port slug
        je curl_ip_field_end;
        cmp r8, 0x2f;                              // '/' -- path slug
        je curl_ip_field_end;
        cmp r8, 0x2e;                              // '.'
        je curl_ip_dot;
        // digit?
        sub r8, 48;
        cmp r8, 9;
        ja curl_ip_bad;
        // acc = acc*10 + digit
        mov r9, rdi;
        shl rdi, 3;
        add rdi, r9;
        add rdi, r9;
        add rdi, r8;
        cmp rdi, 255;                              // per-octet cap
        ja curl_ip_bad;
        add rcx, 1;
        add r10, 1;
        cmp r10, 3;                                // max 3 digits per octet
        ja curl_ip_bad;
        jmp curl_ip_digit_loop;

      curl_ip_dot:
        cmp r10, 0;                                // empty field?
        je curl_ip_bad;
        shl rdx, 8;
        add rdx, rdi;
        add r11, 1;
        cmp r11, 3;                                // max 3 dots
        ja curl_ip_bad;
        add rcx, 1;                                // skip '.'
        jmp curl_ip_field;

      curl_ip_field_end:
        cmp r10, 0;
        je curl_ip_bad;
        cmp r11, 3;                                // must have 3 dots
        jne curl_ip_bad;
        shl rdx, 8;
        add rdx, rdi;
        // ip parsed; rdx = ip u32. Store.
        mov [rip + curl_url_ip], rdx;

        // Compute host length (rcx - host_start).
        mov r9, rcx;
        sub r9, r15;                               // r9 = host_len
        mov [rip + curl_url_host_len], r9;

        // What terminated the host? Re-read byte at rax+rcx.
        xor r8, r8;
        mov_b r8, [rax + rcx*1];
        cmp r8, 0x3a;                              // ':' -- port slug
        je curl_url_parse_port;
        // No port -> default per scheme.
        mov r9, [rip + curl_url_scheme];
        cmp r9, 0;
        je curl_url_port_http;
        mov r9, 443;
        jmp curl_url_port_done;
      curl_url_port_http:
        mov r9, 80;
        jmp curl_url_port_done;

      curl_url_parse_port:
        // rcx points at ':'. Skip it, then parse decimal digits.
        add rcx, 1;
        xor r9, r9;                                // port acc
        xor r10, r10;                              // digit count
      curl_port_loop:
        xor r8, r8;
        mov_b r8, [rax + rcx*1];
        cmp r8, 0;
        je curl_port_done_end;
        cmp r8, 0x2f;                              // '/'
        je curl_port_done_end;
        sub r8, 48;
        cmp r8, 9;
        ja curl_url_bad;
        mov rdi, r9;
        shl r9, 3;
        add r9, rdi;
        add r9, rdi;
        add r9, r8;
        cmp r9, 65535;
        ja curl_url_bad;
        add rcx, 1;
        add r10, 1;
        cmp r10, 5;
        ja curl_url_bad;
        jmp curl_port_loop;
      curl_port_done_end:
        cmp r10, 0;
        je curl_url_bad;

      curl_url_port_done:
        mov [rip + curl_url_port], r9;

        // Path parse. rcx points at NUL or '/'.
        xor r8, r8;
        mov_b r8, [rax + rcx*1];
        cmp r8, 0;
        je curl_url_path_default;
        // Path starts at rax + rcx; walk to NUL for length.
        mov r9, rax;
        add r9, rcx;                               // r9 = path ptr
        mov [rip + curl_url_path_ptr], r9;
        xor r10, r10;                              // path len
      curl_path_len_loop:
        xor r8, r8;
        mov_b r8, [rax + rcx*1];
        cmp r8, 0;
        je curl_path_len_done;
        add rcx, 1;
        add r10, 1;
        cmp r10, 512;
        ja curl_url_bad;
        jmp curl_path_len_loop;
      curl_path_len_done:
        mov [rip + curl_url_path_len], r10;
        jmp curl_url_parse_ok;

      curl_url_path_default:
        // No path slug -> use CURL_PATH_ROOT = "/".
        lea r9, [rip + CURL_PATH_ROOT];
        mov [rip + curl_url_path_ptr], r9;
        mov r10, 1;
        mov [rip + curl_url_path_len], r10;

      curl_url_parse_ok:
        // ============================================================
        // Phase B.4: --audit-only short-circuit (pdxcurl#11, M3-004).
        // Takes priority over the https/--trust= gate below: an
        // audit-only run performs no network I/O regardless of scheme,
        // so it needs no TLS trust resolution either.
        // ============================================================
        lea r15, [rip + curl_argv_slots];
        mov r9, [r15 + 48];                        // audit_only flag
        cmp r9, 0;
        jne curl_audit_only_path;

        // https:// requires a --trust=cap:<n> token (pdxcurl#8,
        // M3-001); without one it still refuses at curl_tls_not_yet.
        mov r9, [rip + curl_url_scheme];
        cmp r9, 0;
        je curl_method_determine;
        lea r15, [rip + curl_argv_slots];
        mov r8, [r15 + 32];                        // trust_present
        cmp r8, 0;
        je curl_tls_not_yet;

      curl_method_determine:
        // ============================================================
        // Phase B.5: determine method (0=GET, 1=POST).
        // ============================================================
        // POST iff curl_argv_slots+16 (data_ptr) != 0.
        lea r15, [rip + curl_argv_slots];
        mov r8, [r15 + 16];
        cmp r8, 0;
        je curl_method_get;
        mov r14, 1;                                // method = POST
        jmp curl_method_done;
      curl_method_get:
        xor r14, r14;                              // method = GET
      curl_method_done:

        // Latch peer coords for Phase C into callee-save regs.
        mov rbp, [rip + curl_url_ip];              // rbp = ip u32
        mov rbx, [rip + curl_url_port];            // rbx = port

        // ============================================================
        // Phase C.0: emit AUDIT-INTENT record.
        // ============================================================
        // HttpRequestRecord@0.1 into curl_audit_record_buf:
        //   +0  magic ("PDXKCURL")
        //   +8  version=1 flags=0
        //   +16 method_and_scheme (method | scheme<<8) status=0
        //   +24 body_bytes=0
        //   +32 redirect_count=0 header_count=0
        //   +40 result_code = RC_INTENT (12) reserved=0
        lea r15, [rip + curl_audit_record_buf];
        mov rax, [rip + curl_hrr_magic];
        mov [r15 + 0], rax;
        mov rax, 1;                                // version=1, flags=0
        mov [r15 + 8], rax;
        // Pack method_and_scheme into low 32 bits; scheme in bits [8..15].
        mov rax, r14;                              // method low byte
        mov r9, [rip + curl_url_scheme];
        shl r9, 8;
        or rax, r9;
        // Upper 32 bits = status = 0.
        mov [r15 + 16], rax;
        xor rax, rax;
        mov [r15 + 24], rax;                       // body_bytes
        mov [r15 + 32], rax;                       // redirect + header counts
        mov rax, 12;                               // RC_INTENT
        mov [r15 + 40], rax;                       // result_code + reserved

        // sys_semantic_send(schema=audit, rec_ptr, 48).
        mov rdi, [rip + curl_schema_audit];
        lea rsi, [rip + curl_audit_record_buf];
        mov rdx, 48;
        mov rax, 115;
        syscall;

        // ============================================================
        // Phase C.1: sys_socket + sys_connect.
        // ============================================================
        mov rdi, 2;                                // AF_INET
        mov rsi, 1;                                // SOCK_STREAM
        xor rdx, rdx;                              // proto=0
        mov rax, 87;
        syscall;
        cmp rax, 0;
        jl curl_socket_fail;
        mov r15, rax;                              // r15 = socket fd
        // Stash socket fd into .bss so Phase C.2 (which reuses r15 as
        // a lea into curl_argv_slots) does not lose it. Phase C.3 /
        // Phase D re-read from curl_sock_fd_slot.
        mov [rip + curl_sock_fd_slot], r15;

        mov rdi, r15;
        mov rsi, rbp;                              // ip
        mov rdx, rbx;                              // port
        mov rax, 91;
        syscall;
        cmp rax, 0;
        jl curl_connect_fail;

        // ============================================================
        // Phase C.1.5: TLS wrap (pdxcurl#8, M3-001). Only reached when
        // scheme==1 (https), which by the Phase B.4 gate above implies
        // trust_present==1 (curl_argv_slots+32 != 0).
        // ============================================================
        mov r9, [rip + curl_url_scheme];
        cmp r9, 0;
        je curl_after_tls_wrap;
        lea r15, [rip + curl_argv_slots];
        mov rdi, [rip + curl_sock_fd_slot];
        mov rsi, [r15 + 40];                       // trust_cap_n
        mov rdx, [rip + curl_url_host_ptr];
        mov rcx, [rip + curl_url_host_len];
        call tls_wire_net_tls_wrap;
        cmp rax, 0;
        jne curl_tls_wrap_fail;
      curl_after_tls_wrap:

        // ============================================================
        // Phase C.2: assemble request into curl_req_buf.
        // r12 = req_len accumulator.
        // ============================================================
        xor r12, r12;
        lea rdi, [rip + curl_req_buf];             // rdi = dst base

        // Method fragment.
        cmp r14, 0;
        je curl_emit_get;
        // POST.
        lea rsi, [rip + curl_frag_post];
        mov rdx, 5;                                // curl_frag_post_len
        jmp curl_copy_frag;
      curl_emit_get:
        lea rsi, [rip + curl_frag_get];
        mov rdx, 4;                                // curl_frag_get_len

      curl_copy_frag:
        // memcpy(rdi + r12, rsi, rdx). Uses rcx cursor + rax scratch.
        xor rcx, rcx;
      curl_copy_frag_loop:
        cmp rcx, rdx;
        jae curl_after_method_frag;
        xor rax, rax;
        mov_b rax, [rsi + rcx*1];
        mov_b [rdi + r12*1], rax;
        add r12, 1;
        add rcx, 1;
        jmp curl_copy_frag_loop;

      curl_after_method_frag:
        // Copy path.
        mov rsi, [rip + curl_url_path_ptr];
        mov rdx, [rip + curl_url_path_len];
        xor rcx, rcx;
      curl_copy_path_loop:
        cmp rcx, rdx;
        jae curl_after_path;
        xor rax, rax;
        mov_b rax, [rsi + rcx*1];
        mov_b [rdi + r12*1], rax;
        add r12, 1;
        add rcx, 1;
        jmp curl_copy_path_loop;

      curl_after_path:
        // Copy " HTTP/1.0\r\n".
        lea rsi, [rip + curl_frag_http10];
        mov rdx, 11;
        xor rcx, rcx;
      curl_copy_http10_loop:
        cmp rcx, rdx;
        jae curl_after_http10;
        xor rax, rax;
        mov_b rax, [rsi + rcx*1];
        mov_b [rdi + r12*1], rax;
        add r12, 1;
        add rcx, 1;
        jmp curl_copy_http10_loop;

      curl_after_http10:
        // "Host: ".
        lea rsi, [rip + curl_frag_host];
        mov rdx, 6;
        xor rcx, rcx;
      curl_copy_hosthdr_loop:
        cmp rcx, rdx;
        jae curl_after_hosthdr;
        xor rax, rax;
        mov_b rax, [rsi + rcx*1];
        mov_b [rdi + r12*1], rax;
        add r12, 1;
        add rcx, 1;
        jmp curl_copy_hosthdr_loop;

      curl_after_hosthdr:
        // Copy host substring.
        mov rsi, [rip + curl_url_host_ptr];
        mov rdx, [rip + curl_url_host_len];
        xor rcx, rcx;
      curl_copy_host_loop:
        cmp rcx, rdx;
        jae curl_after_host;
        xor rax, rax;
        mov_b rax, [rsi + rcx*1];
        mov_b [rdi + r12*1], rax;
        add r12, 1;
        add rcx, 1;
        jmp curl_copy_host_loop;

      curl_after_host:
        // "\r\n".
        lea rsi, [rip + curl_frag_crlf];
        mov rdx, 2;
        xor rcx, rcx;
      curl_copy_crlf1_loop:
        cmp rcx, rdx;
        jae curl_after_crlf1;
        xor rax, rax;
        mov_b rax, [rsi + rcx*1];
        mov_b [rdi + r12*1], rax;
        add r12, 1;
        add rcx, 1;
        jmp curl_copy_crlf1_loop;

      curl_after_crlf1:
        // If POST: Content-Length header + terminator + body.
        cmp r14, 0;
        je curl_finish_headers;

        // "Content-Length: ".
        lea rsi, [rip + curl_frag_clen];
        mov rdx, 16;
        xor rcx, rcx;
      curl_copy_clen_loop:
        cmp rcx, rdx;
        jae curl_after_clen;
        xor rax, rax;
        mov_b rax, [rsi + rcx*1];
        mov_b [rdi + r12*1], rax;
        add r12, 1;
        add rcx, 1;
        jmp curl_copy_clen_loop;

      curl_after_clen:
        // Decimal-encode data_len into curl_clen_buf. Emit LSD-first,
        // then reverse-copy into curl_req_buf.
        lea r15, [rip + curl_argv_slots];
        mov rax, [r15 + 24];                       // data_len (u64)
        lea r8, [rip + curl_clen_buf];             // scratch
        xor r9, r9;                                // digit count
        cmp rax, 0;
        jne curl_clen_encode_loop;
        // data_len == 0: emit single '0'.
        mov r10, 48;
        mov_b [r8 + 0], r10;
        mov r9, 1;
        jmp curl_clen_encoded;
      curl_clen_encode_loop:
        cmp rax, 0;
        je curl_clen_encoded;
        mov r10, 10;
        xor rdx, rdx;
        div r10;                                   // rax = rax/10, rdx = rax%10
        add rdx, 48;
        mov_b [r8 + r9*1], rdx;
        add r9, 1;
        jmp curl_clen_encode_loop;

      curl_clen_encoded:
        // Reverse-copy r9 bytes from r8 (LSD-first) into curl_req_buf
        // + r12 (MSD-first). rcx counts written, r10 = source index.
        xor rcx, rcx;
      curl_clen_rev_loop:
        cmp rcx, r9;
        jae curl_after_clen_val;
        mov r10, r9;
        sub r10, rcx;
        sub r10, 1;                                // src idx = r9-1-rcx
        xor rax, rax;
        mov_b rax, [r8 + r10*1];
        mov_b [rdi + r12*1], rax;
        add r12, 1;
        add rcx, 1;
        jmp curl_clen_rev_loop;

      curl_after_clen_val:
        // "\r\n".
        lea rsi, [rip + curl_frag_crlf];
        mov rdx, 2;
        xor rcx, rcx;
      curl_copy_crlf2_loop:
        cmp rcx, rdx;
        jae curl_after_crlf2;
        xor rax, rax;
        mov_b rax, [rsi + rcx*1];
        mov_b [rdi + r12*1], rax;
        add r12, 1;
        add rcx, 1;
        jmp curl_copy_crlf2_loop;

      curl_after_crlf2:
        // Final "\r\n" (end of headers).
        lea rsi, [rip + curl_frag_crlf];
        mov rdx, 2;
        xor rcx, rcx;
      curl_copy_crlf3_loop:
        cmp rcx, rdx;
        jae curl_after_crlf3_post;
        xor rax, rax;
        mov_b rax, [rsi + rcx*1];
        mov_b [rdi + r12*1], rax;
        add r12, 1;
        add rcx, 1;
        jmp curl_copy_crlf3_loop;

      curl_after_crlf3_post:
        // Copy POST body from curl_argv_slots+16 (data_ptr), data_len
        // bytes.
        lea r15, [rip + curl_argv_slots];
        mov rsi, [r15 + 16];
        mov rdx, [r15 + 24];
        xor rcx, rcx;
      curl_copy_body_loop:
        cmp rcx, rdx;
        jae curl_req_ready;
        xor rax, rax;
        mov_b rax, [rsi + rcx*1];
        mov_b [rdi + r12*1], rax;
        add r12, 1;
        add rcx, 1;
        jmp curl_copy_body_loop;

      curl_finish_headers:
        // GET terminator: single "\r\n".
        lea rsi, [rip + curl_frag_crlf];
        mov rdx, 2;
        xor rcx, rcx;
      curl_copy_crlf_get_loop:
        cmp rcx, rdx;
        jae curl_req_ready;
        xor rax, rax;
        mov_b rax, [rsi + rcx*1];
        mov_b [rdi + r12*1], rax;
        add r12, 1;
        add rcx, 1;
        jmp curl_copy_crlf_get_loop;

      curl_req_ready:
        // ============================================================
        // Phase C.3: sys_send. Socket fd re-read from .bss because the
        // request-assembly block above lea'd r15 into curl_argv_slots.
        // ============================================================
        mov rdi, [rip + curl_sock_fd_slot];
        lea rsi, [rip + curl_req_buf];
        mov rdx, r12;                              // req_len
        mov rax, 92;                               // sys_send
        syscall;
        cmp rax, 0;
        jl curl_send_fail;

        // ============================================================
        // Phase D: sys_recv into curl_resp_buf (single 4 KiB call).
        // ============================================================
        mov rdi, [rip + curl_sock_fd_slot];
        lea rsi, [rip + curl_resp_buf];
        mov rdx, 4096;
        mov rax, 93;                               // sys_recv
        syscall;
        cmp rax, 0;
        jl curl_recv_fail;
        mov r12, rax;                              // r12 = bytes_recv'd

        // Guard: need at least "HTTP/1.X SSS\r\n\r\n" (~20 bytes).
        cmp r12, 20;
        jl curl_bad_resp;

        // Parse status: response[9..12] as three ASCII digits.
        // Byte 9 = '0'..'5' typically (100..599).
        lea r8, [rip + curl_resp_buf];
        xor rax, rax;
        mov_b rax, [r8 + 9];
        sub rax, 48;
        cmp rax, 9;
        ja curl_bad_resp;
        mov r13, rax;
        xor rax, rax;
        mov_b rax, [r8 + 10];
        sub rax, 48;
        cmp rax, 9;
        ja curl_bad_resp;
        mov r10, r13;
        shl r13, 3;
        add r13, r10;
        add r13, r10;                              // *10
        add r13, rax;
        xor rax, rax;
        mov_b rax, [r8 + 11];
        sub rax, 48;
        cmp rax, 9;
        ja curl_bad_resp;
        mov r10, r13;
        shl r13, 3;
        add r13, r10;
        add r13, r10;
        add r13, rax;                              // r13 = status (u32)

        // Find "\r\n\r\n" in response (0x0D 0x0A 0x0D 0x0A). rcx = cursor.
        xor rcx, rcx;
      curl_scan_hdrs_loop:
        mov r10, rcx;
        add r10, 4;
        cmp r10, r12;                              // cursor+4 > bytes_recv
        ja curl_bad_resp;
        xor rax, rax;
        mov_b rax, [r8 + rcx*1];
        cmp rax, 0x0d;
        jne curl_scan_hdrs_next;
        xor rax, rax;
        mov r11, rcx;
        add r11, 1;
        mov_b rax, [r8 + r11*1];
        cmp rax, 0x0a;
        jne curl_scan_hdrs_next;
        xor rax, rax;
        add r11, 1;
        mov_b rax, [r8 + r11*1];
        cmp rax, 0x0d;
        jne curl_scan_hdrs_next;
        xor rax, rax;
        add r11, 1;
        mov_b rax, [r8 + r11*1];
        cmp rax, 0x0a;
        jne curl_scan_hdrs_next;
        // Found. Body starts at rcx+4.
        add rcx, 4;
        jmp curl_have_body;
      curl_scan_hdrs_next:
        add rcx, 1;
        jmp curl_scan_hdrs_loop;

      curl_have_body:
        // Body offset in rcx; body_len = r12 - rcx.
        mov r9, r12;
        sub r9, rcx;                               // r9 = body_len
        // r12 flip: from bytes_recv to body_len for the RESULT record.
        mov r12, r9;
        // Compute body pointer.
        lea r8, [rip + curl_resp_buf];
        add r8, rcx;                               // r8 = body_ptr

        // ============================================================
        // Phase D.1: open output fd if --output.
        // ============================================================
        lea r15, [rip + curl_argv_slots];
        mov r9, [r15 + 8];                         // output_ptr
        cmp r9, 0;
        je curl_out_stdout;
        // sys_open(path, O_CREAT|O_WRONLY|O_TRUNC=0xC1, mode=0644).
        // Save body ptr in .bss slot across the syscall (r8 is caller-
        // save; rcx/r11 SYSCALL-clobbered).
        mov [rip + curl_body_ptr_slot], r8;
        mov [rip + curl_body_len_slot], r12;
        mov rdi, r9;                               // path
        mov rsi, 0xC1;                             // flags
        mov rdx, 0x1A4;                            // mode = 0644 octal
        mov rax, 2;                                // sys_open
        syscall;
        cmp rax, 0;
        jl curl_open_fail;
        mov [rip + curl_out_fd_slot], rax;
        // Restore body ptr / len.
        mov r8, [rip + curl_body_ptr_slot];
        mov r12, [rip + curl_body_len_slot];
        jmp curl_out_ready;
      curl_out_stdout:
        mov rax, 1;
        mov [rip + curl_out_fd_slot], rax;

      curl_out_ready:
        // sys_write(fd, body_ptr, body_len).
        mov rdi, [rip + curl_out_fd_slot];
        mov rsi, r8;
        mov rdx, r12;
        mov rax, 1;                                // sys_write
        syscall;
        // Ignore short-write; bytes_written = min(returned, r12).

        // Close output fd if not stdout.
        mov r9, [rip + curl_out_fd_slot];
        cmp r9, 1;
        je curl_skip_close_out;
        mov rdi, r9;
        mov rax, 3;                                // sys_close
        syscall;
      curl_skip_close_out:

        // Close socket.
        mov rdi, [rip + curl_sock_fd_slot];
        mov rax, 3;
        syscall;

        // ============================================================
        // Phase D.2: emit AUDIT-RESULT record.
        // ============================================================
        // result_code:
        //   status >= 200 && status < 400 -> RC_OK = 0
        //   status >= 400 && status < 500 -> RC_HTTP_4XX = 5
        //   status >= 500 && status < 600 -> RC_HTTP_5XX = 6
        //   else -> RC_HTTP_4XX default
        xor r9, r9;                                // default RC_OK
        cmp r13, 400;
        jl curl_result_ok;
        cmp r13, 500;
        jl curl_result_4xx;
        cmp r13, 600;
        jl curl_result_5xx;
        // >=600 treated as 5xx.
      curl_result_5xx:
        mov r9, 6;
        jmp curl_result_encoded;
      curl_result_4xx:
        mov r9, 5;
        jmp curl_result_encoded;
      curl_result_ok:
        xor r9, r9;

      curl_result_encoded:
        // Save result_code for exit computation.
        mov [rip + curl_result_rc_slot], r9;

        // Marshal audit-RESULT record.
        lea r15, [rip + curl_audit_record_buf];
        mov rax, [rip + curl_hrr_magic];
        mov [r15 + 0], rax;
        mov rax, 1;
        mov [r15 + 8], rax;
        // Pack method_and_scheme (low 32) + status (high 32) into one u64.
        mov rax, r14;
        mov r10, [rip + curl_url_scheme];
        shl r10, 8;
        or rax, r10;
        // status in high 32 bits.
        mov r10, r13;
        shl r10, 32;
        or rax, r10;
        mov [r15 + 16], rax;
        mov [r15 + 24], r12;                       // body_bytes
        xor rax, rax;
        mov [r15 + 32], rax;                       // header + redirect counts
        mov [r15 + 40], r9;                        // result_code

        mov rdi, [rip + curl_schema_audit];
        lea rsi, [rip + curl_audit_record_buf];
        mov rdx, 48;
        mov rax, 115;
        syscall;

        // ============================================================
        // Phase D.3: emit PIPE record (v1.1-B schema, real fields).
        // ============================================================
        lea r15, [rip + curl_record_buf];
        mov rax, [rip + curl_hrr_magic];
        mov [r15 + 0], rax;
        mov rax, 1;
        mov [r15 + 8], rax;
        // method_and_scheme (low 32) + status (high 32).
        mov rax, r14;
        mov r10, [rip + curl_url_scheme];
        shl r10, 8;
        or rax, r10;
        mov r10, r13;
        shl r10, 32;
        or rax, r10;
        mov [r15 + 16], rax;
        mov [r15 + 24], r12;                       // body_bytes
        xor rax, rax;
        mov [r15 + 32], rax;
        mov [r15 + 40], r9;                        // result_code

        mov rdi, [rip + curl_schema_http_req];
        lea rsi, [rip + curl_record_buf];
        mov rdx, 48;
        mov rax, 115;
        syscall;

        // ============================================================
        // Phase D.4: sys_exit with taxonomy exit code.
        // ============================================================
        // rc -> exit_code:
        //   RC_OK (0)      -> EXIT_OK       (0)
        //   RC_HTTP_4XX(5) -> EXIT_HTTP_4XX (4)
        //   RC_HTTP_5XX(6) -> EXIT_HTTP_5XX (5)
        mov r9, [rip + curl_result_rc_slot];
        cmp r9, 5;
        je curl_exit_4xx;
        cmp r9, 6;
        je curl_exit_5xx;
        // OK.
        xor rdi, rdi;
        mov rax, 60;
        syscall;
        hlt;
      curl_exit_4xx:
        mov rdi, 4;
        mov rax, 60;
        syscall;
        hlt;
      curl_exit_5xx:
        mov rdi, 5;
        mov rax, 60;
        syscall;
        hlt;

        // ============================================================
        // Diagnostic exit branches. Each emits its diagnostic on fd 2,
        // an audit-RESULT record with the matching RC_*, then exits
        // with the taxonomy exit code.
        // ============================================================

      curl_usage:
        mov rdi, 2;
        lea rsi, [rip + curl_msg_usage];
        mov rdx, 47;
        mov rax, 1;
        syscall;
        mov rdi, 2;
        mov rax, 60;
        syscall;
        hlt;

      curl_url_bad:
        mov rdi, 2;
        lea rsi, [rip + curl_msg_bad_url];
        mov rdx, 32;
        mov rax, 1;
        syscall;
        mov rdi, 2;
        mov rax, 60;
        syscall;
        hlt;

      curl_ip_bad:
        mov rdi, 2;
        lea rsi, [rip + curl_msg_bad_ip];
        mov rdx, 37;
        mov rax, 1;
        syscall;
        mov rdi, 2;
        mov rax, 60;
        syscall;
        hlt;

      curl_audit_only_path:
        // ============================================================
        // pdxcurl#11 M3-004: --audit-only INTENT-only terminal path.
        // Reached from curl_url_parse_ok (Phase B.4) before any
        // socket-family syscall. Determine method (needed for the
        // record's method_and_scheme field), marshal + emit an INTENT
        // record to the audit sink, write a human-readable fingerprint
        // to fd 2, then sys_exit(EXIT_SUCCESS_AUDIT_ONLY=200). No TCP
        // connect, no HTTP send/recv, no semantic-pipe HRR emit.
        // ============================================================
        lea r15, [rip + curl_argv_slots];
        mov r8, [r15 + 16];                        // data_ptr
        cmp r8, 0;
        je curl_audit_only_method_get;
        mov r14, 1;                                // method = POST
        jmp curl_audit_only_method_done;
      curl_audit_only_method_get:
        xor r14, r14;                              // method = GET
      curl_audit_only_method_done:

        lea r15, [rip + curl_audit_record_buf];
        mov rax, [rip + curl_hrr_magic];
        mov [r15 + 0], rax;
        mov rax, 1;                                // version=1, flags=0
        mov [r15 + 8], rax;
        mov rax, r14;
        mov r9, [rip + curl_url_scheme];
        shl r9, 8;
        or rax, r9;
        mov [r15 + 16], rax;
        xor rax, rax;
        mov [r15 + 24], rax;                       // body_bytes
        mov [r15 + 32], rax;                       // redirect + header counts
        mov rax, 11;                               // RC_AUDIT_ONLY
        mov [r15 + 40], rax;

        mov rdi, [rip + curl_schema_audit];
        lea rsi, [rip + curl_audit_record_buf];
        mov rdx, 48;
        mov rax, 115;
        syscall;

        mov rdi, 2;
        lea rsi, [rip + curl_msg_audit_only];
        mov rdx, 46;                               // curl_msg_audit_only_len
        mov rax, 1;
        syscall;

        mov rdi, 200;                              // EXIT_SUCCESS_AUDIT_ONLY
        mov rax, 60;
        syscall;
        hlt;

      curl_tls_not_yet:
        mov rdi, 2;
        lea rsi, [rip + curl_msg_tls_not_yet];
        mov rdx, 38;
        mov rax, 1;
        syscall;
        // Inline audit-RESULT emit: RC_TLS_HANDSHAKE_FAILED = 4.
        // curl_url_scheme = 1 here (https:// path); method still 0.
        lea r15, [rip + curl_audit_record_buf];
        mov rax, [rip + curl_hrr_magic];
        mov [r15 + 0], rax;
        mov rax, 1;
        mov [r15 + 8], rax;
        mov rax, 0x0100;                           // method=0, scheme=1<<8
        mov [r15 + 16], rax;
        xor rax, rax;
        mov [r15 + 24], rax;
        mov [r15 + 32], rax;
        mov rax, 4;                                // RC_TLS_HANDSHAKE_FAILED
        mov [r15 + 40], rax;
        mov rdi, [rip + curl_schema_audit];
        lea rsi, [rip + curl_audit_record_buf];
        mov rdx, 48;
        mov rax, 115;
        syscall;
        mov rdi, 9;                                // EXIT_TLS_HANDSHAKE_FAILED
        mov rax, 60;
        syscall;
        hlt;

      curl_socket_fail:
        mov rdi, 2;
        lea rsi, [rip + curl_msg_socket_fail];
        mov rdx, 23;
        mov rax, 1;
        syscall;
        mov rdi, 4;                                // ad-hoc socket failure
        mov rax, 60;
        syscall;
        hlt;

      curl_connect_fail:
        mov rdi, 2;
        lea rsi, [rip + curl_msg_connect_fail];
        mov rdx, 24;
        mov rax, 1;
        syscall;
        // Inline audit-RESULT emit: RC_CONN_REFUSED = 2.
        // Pack method (r14) | scheme<<8 in low 32; upper 32 = 0.
        lea r15, [rip + curl_audit_record_buf];
        mov rax, [rip + curl_hrr_magic];
        mov [r15 + 0], rax;
        mov rax, 1;
        mov [r15 + 8], rax;
        mov rax, r14;
        mov r10, [rip + curl_url_scheme];
        shl r10, 8;
        or rax, r10;
        mov [r15 + 16], rax;
        xor rax, rax;
        mov [r15 + 24], rax;
        mov [r15 + 32], rax;
        mov rax, 2;                                // RC_CONN_REFUSED
        mov [r15 + 40], rax;
        mov rdi, [rip + curl_schema_audit];
        lea rsi, [rip + curl_audit_record_buf];
        mov rdx, 48;
        mov rax, 115;
        syscall;
        mov rdi, 7;                                // EXIT_CONN_REFUSED
        mov rax, 60;
        syscall;
        hlt;

      curl_tls_wrap_fail:
        // pdxcurl#8 M3-001: tls_wire_net_tls_wrap returned nonzero.
        // Unreachable while TlsWire::net_tls_wrap stays a WEAK-stub
        // passthrough (always returns 0); wired for when a real
        // libpdx-net M5 landing swaps that stub for a real handshake.
        mov rdi, 2;
        lea rsi, [rip + curl_msg_tls_wrap_fail];
        mov rdx, 25;                               // curl_msg_tls_wrap_fail_len
        mov rax, 1;
        syscall;
        lea r15, [rip + curl_audit_record_buf];
        mov rax, [rip + curl_hrr_magic];
        mov [r15 + 0], rax;
        mov rax, 1;
        mov [r15 + 8], rax;
        mov rax, r14;
        mov r10, [rip + curl_url_scheme];
        shl r10, 8;
        or rax, r10;
        mov [r15 + 16], rax;
        xor rax, rax;
        mov [r15 + 24], rax;
        mov [r15 + 32], rax;
        mov rax, 4;                                // RC_TLS_HANDSHAKE_FAILED
        mov [r15 + 40], rax;
        mov rdi, [rip + curl_schema_audit];
        lea rsi, [rip + curl_audit_record_buf];
        mov rdx, 48;
        mov rax, 115;
        syscall;
        mov rdi, 9;                                // EXIT_TLS_HANDSHAKE_FAILED
        mov rax, 60;
        syscall;
        hlt;

      curl_send_fail:
        mov rdi, 2;
        lea rsi, [rip + curl_msg_send_fail];
        mov rdx, 21;
        mov rax, 1;
        syscall;
        mov rdi, 7;
        mov rax, 60;
        syscall;
        hlt;

      curl_recv_fail:
        mov rdi, 2;
        lea rsi, [rip + curl_msg_recv_fail];
        mov rdx, 21;
        mov rax, 1;
        syscall;
        mov rdi, 7;
        mov rax, 60;
        syscall;
        hlt;

      curl_open_fail:
        mov rdi, 2;
        lea rsi, [rip + curl_msg_open_fail];
        mov rdx, 26;
        mov rax, 1;
        syscall;
        mov rdi, 3;                                // EXIT_CAPS_REFUSED
        mov rax, 60;
        syscall;
        hlt;

      curl_bad_resp:
        mov rdi, 2;
        lea rsi, [rip + curl_msg_bad_resp];
        mov rdx, 33;
        mov rax, 1;
        syscall;
        mov rdi, 2;
        mov rax, 60;
        syscall;
        hlt;

      }
    }

  // ==================================================================
  // Phase-C spill slots (see _start justification for register plan).
  // ==================================================================
  //   curl_sock_fd_slot  -- socket fd cached before request assembly
  //                          clobbers r15 (which becomes lea into
  //                          curl_argv_slots + curl_argv_slots-derived
  //                          scratch during Content-Length encode).
  //   curl_out_fd_slot   -- output fd (from sys_open or 1 for stdout).
  //   curl_body_ptr_slot -- body ptr saved across sys_open (caller-save
  //                          scratch would otherwise be clobbered).
  //   curl_body_len_slot -- body len saved across sys_open.
  //   curl_result_rc_slot-- RC_* value emitted in RESULT record; the
  //                          exit-code branch reads it back for the
  //                          taxonomy exit code.
  pub let mut curl_sock_fd_slot      : u64 = uninit @align(8)
  pub let mut curl_out_fd_slot       : u64 = uninit @align(8)
  pub let mut curl_body_ptr_slot     : u64 = uninit @align(8)
  pub let mut curl_body_len_slot     : u64 = uninit @align(8)
  pub let mut curl_result_rc_slot    : u64 = uninit @align(8)

}
