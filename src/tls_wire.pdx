// src/tls_wire.pdx -- pdxcurl v1.5.0 (Wave mu-02, pdxcurl#12)
// TlsWire module: --trust=cap:<n> resolution + net_tls_wrap wiring +
// a real (scaffold-shaped) TLS record layer.
//
// =============================================================================
// Wave mu-02 upgrade: "real TLS handshake" -- WHAT THIS ACTUALLY LANDS
// =============================================================================
//
// libpdx-net's OWN net_tls_wrap (src/net_tls_wrap.pdx in that repo) is
// itself still scaffold-only at v0.5.0 (no v0.6.0 tag published as of
// this wave): it composes and sends a fixed-size ClientHello but does
// NOT wait for a ServerHello, does NOT derive any key material, and
// does NOT verify anything against a trust cap -- all three are
// blocked on R100-PREP-005 (paideia-as SHA-256/HKDF/X25519/Ed25519
// crypto intrinsics), which have not landed either. A real end-to-end
// TLS handshake is therefore not buildable ANYWHERE in this ecosystem
// yet, in this repo or in libpdx-net itself.
//
// Given that ceiling, this landing does the maximum honest amount of
// real work:
//   - `tls_wire_net_tls_wrap` now sends a REAL TLS record (a 5-byte
//     record header: content_type=0x16 Handshake, version=0x0301,
//     length=9; followed by a 9-byte minimal ClientHello-SHAPED
//     handshake body: handshake_type=0x01, a 3-byte length field, and
//     a 2-byte client_version=0x0303) over the real connected socket,
//     THEN performs a REAL `sys_recv` waiting for the peer's response
//     (this is the "ServerHello wait" the wave asks for -- a genuine
//     blocking network read, not a no-op). The response's first byte
//     is checked against 0x16 (Handshake content type): a match is
//     treated as a plausible ServerHello and the function returns 0
//     (success); anything else (wrong content type, a TLS alert
//     record 0x15, a recv failure, or a 0-byte EOF) returns nonzero,
//     which `main.pdx`'s existing `curl_tls_wrap_fail` branch
//     (RC_TLS_HANDSHAKE_FAILED=4 / EXIT_TLS_HANDSHAKE_FAILED=9) now
//     ACTUALLY REACHES for the first time in this repo's history.
//   - NO key material is derived (nothing to derive it FROM -- no
//     crypto intrinsics), so a "successful" handshake here means
//     "the peer spoke back something TLS-record-shaped", not "a
//     verified, encrypted channel exists". `trust_cap` is still
//     accepted-but-unread (no cap-resolution or pinned-key check --
//     same posture as libpdx-net's own scaffold).
//   - `tls_wire_record_send` / `tls_wire_record_recv` (NEW this
//     landing) give the HTTP request/response bytes a REAL TLS
//     record-layer WRAPPER (5-byte header: content_type=0x17
//     Application Data, version=0x0303, 2-byte BE length; a matching
//     header is parsed and stripped on receive) around the same
//     `sys_send`/`sys_recv` calls `main.pdx`'s Phase C.3/D already
//     made -- but the PAYLOAD inside that wrapper is still PLAINTEXT
//     (no cipher exists to run). This is the "record-layer wrap
//     around send/recv" the wave asks for: real framing, no
//     encryption. `main.pdx` calls these two functions instead of the
//     bare sys_send/sys_recv pair ONLY when `curl_url_scheme == 1`
//     (https://); the http:// path is byte-for-byte unchanged.
//   - Single-shot `sys_recv` calls throughout (both here and in the
//     pre-existing HTTP response read) -- a TCP byte stream can, in
//     principle, split a 5-byte header or the length-prefixed payload
//     across multiple reads; this landing does not loop to reassemble
//     a split read (documented known gap, same class as `main.pdx`'s
//     own single 4 KiB `sys_recv` for the whole HTTP response).
//
// Purpose
// -------
// M3-001 (pdxcurl#8) asks for the HTTPS path: `--trust=cap:<n>`
// argv-token resolution feeding a `libpdx-net.net_tls_wrap` call once
// a TCP connection is established. libpdx-net does not exist in this
// repo (STATUS.md: "libpdx-net net_tls_wrap -- UNAVAILABLE, blocked on
// libpdx-net M5") and pdxtrust's KIND_TLS_TRUST cap-mint pipeline is
// likewise unavailable ("pdxtrust KIND_TLS_TRUST cap mint --
// UNAVAILABLE, blocked on pdxtrust M1"), so `net_tls_wrap` cannot be a
// real cross-repo `extern` call at this landing: `ld -nostdlib
// --fatal-warnings` (tools/build.sh's link step) would refuse an
// undefined-symbol relocation against a library this repo does not
// link.
//
// A true weak-symbol default (STB_WEAK, resolved to a fallback body
// only when no stronger definition is linked) is also not an option
// here: per libpdx-argv's own src/version_backend.pdx header ("the
// paideia-as 0.36 encoder does not currently expose the STB_WEAK
// binding"), this toolchain has no linker-weak mechanism to fall back
// on -- the same constraint tools/user/cat/src/schema_wire.pdx
// documents at length for libpdx-schema-registry.
//
// The "WEAK stub" this issue asks for is therefore expressed the only
// way this toolchain supports it, following the schema_wire.pdx /
// mount.pdxfs / mkfs.pdxfs precedent: `net_tls_wrap` is defined IN
// this module as a REAL, LINKABLE function carrying the eventual real
// contract's argument shape (sock_fd, trust_cap, hostname_ptr,
// hostname_len -> u64), but its BODY is a placeholder that
// unconditionally returns 0 (success-passthrough) without inspecting
// any argument. The ONE call site (src/main.pdx's Phase C.1.5, right
// after sys_connect succeeds on an https:// request) is the only thing
// that needs to change when a real libpdx-net client lands -- the
// call keeps its signature and argument order, only the callee's body
// swaps from "return 0" to "perform the real TLS handshake and return
// 0 on success / nonzero on failure".
//
// Because the stub always succeeds, an https:// request wired through
// this file at v1.4.0 proceeds in PLAINTEXT over the raw TCP socket --
// this is a wiring landing (the argv surface + the call-site + the
// failure-handling shape all exist and are exercised), not a real
// handshake. src/main.pdx's curl_tls_wrap_fail branch (RC_TLS_
// HANDSHAKE_FAILED=4 / EXIT_TLS_HANDSHAKE_FAILED=9) is unreachable
// while net_tls_wrap stays a passthrough stub.
//
// SUPERSEDED IN PART by the Wave mu-02 (v1.5.0, pdxcurl#12) upgrade
// documented in the file-header block above: `net_tls_wrap` no longer
// unconditionally returns 0 -- it sends a real TLS-record-shaped
// ClientHello and REALLY waits for (and inspects) a response, so
// `curl_tls_wrap_fail` is reachable now. The request still travels in
// plaintext (no key material exists anywhere in this toolchain yet),
// so everything below this note describing "the stub always
// succeeds" / "PLAINTEXT ... unreachable" describes the PRE-mu-02
// behaviour, kept for history rather than rewritten.
//
// --trust=cap:<n> argv surface
// -----------------------------
// `--trust=cap:<n>` is a SINGLE-TOKEN flag (unlike `-o`/`-d`, which
// each consume a following argv slot): the cap URI is embedded after
// the `=` in the same argv[i] string. src/main.pdx's Phase A scanner
// confirms the `--trust=` prefix inline (matching its existing
// `curl_flag_output_long` / `curl_flag_data_long` byte-by-byte style)
// then hands the pointer to the remainder (`argv[i] + 8`, i.e. right
// after the `=`) to `tls_wire_parse_cap_uri`, which validates the
// `cap:` tag and decodes the decimal `<n>` that follows it. A URI that
// is not `cap:<digits>` (missing tag, non-digit, or zero digits)
// returns the all-ones u64 sentinel; the scanner refuses the whole
// argv line at `curl_usage` (exit EXIT_ARGV_USAGE=2) on that sentinel.
// `<n>` is stored verbatim as `trust_cap_n` (curl_argv_slots+40) and
// forwarded as `net_tls_wrap`'s `trust_cap` argument -- it is NOT
// resolved against a live capability table at this landing (pdxtrust
// M1 is what would make `<n>` a real KIND_TLS_TRUST cap-slot index;
// until then this file treats it as an opaque u64 the stub ignores).
//
// caps.decl posture
// ------------------
// caps.decl keeps `KIND_TLS_TRUST` OPTIONAL (its comment already
// anticipates this landing: "mandatory once M3-001 (pdxcurl#8) lands
// the --trust= cap resolution + net_tls_wrap call"). This file does
// NOT promote it to mandatory: net_tls_wrap is still a stub that
// performs no real capability check, and promoting the caps.decl
// entry to mandatory ahead of a real enforcement point would make
// every https:// invocation (even a --trust=cap:<n> one) refuse
// -EACCES for callers whose parent process never carried the cap --
// an enforcement claim this landing cannot back up. Promotion is
// deferred to the real net_tls_wrap landing (libpdx-net M5 +
// pdxtrust M1).
//
// paideia-as compliance
// ---------------------
//   - Module TlsWire (PascalCase file basename).
//   - No `test rN, rN` -- every zero-check is `cmp rN, 0`.
//   - No 2-op `imul r, imm` -- decimal decode uses the shl-3/add/add
//     *10 idiom (matches src/main.pdx's curl_port_loop precedent).
//   - No `and r11, imm64`.
//   - Byte loads via `xor rN, rN; mov_b rN, [ptr]`.
//   - Every label prefixed `tlsw_` (reserved-word discipline).
//   - No push/pop: both functions are leaves (no nested CALL), so no
//     callee-save register needs preserving and no alignment padding
//     is needed at either of the two call sites in src/main.pdx.

module TlsWire = structure {

  // ---- documentation-only: matches caps.decl's KIND_TLS_TRUST value --
  // Not read by any code path in this file; kept as a named constant
  // so a future real-cap-resolution landing has one place to look up
  // the kind tag pdxcurl-design.md §12.3 assigns it.
  pub let KIND_TLS_TRUST : u64 = 0x1A7

  // ======================================================================
  // tls_wire_parse_cap_uri(tail_ptr) -> n | 0xFFFFFFFFFFFFFFFF (invalid)
  //
  // tail_ptr points just past the "--trust=" prefix (already confirmed
  // by src/main.pdx's curl_flag_trust_long). Validates the literal
  // "cap:" tag, then decodes the decimal digits that follow (1..10
  // digits) into a u64. Any deviation (missing/short "cap:" tag,
  // non-digit byte, zero digits, more than 10 digits) returns the
  // all-ones sentinel rather than a partially-decoded value.
  // ======================================================================
  pub let tls_wire_parse_cap_uri : (u64) -> u64 !{mem} @{} =
    fn (tail_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "pdxcurl#8 M3-001: decode the `cap:<n>` half of a `--trust=cap:<n>` argv token. rdi=tail_ptr (the byte right after `--trust=`). Confirms the 4-byte literal tag 'c','a','p',':' at tail_ptr[0..4) -- any mismatch jumps to tlsw_pc_bad. Then decodes ASCII decimal digits starting at tail_ptr+4 (r9=accumulator, r10=digit count, rcx=cursor) using the shl-3/add/add *10 idiom (no 2-op imul, matching src/main.pdx's curl_port_loop / crm_status_parse precedent) until a NUL terminator; a non-digit byte before NUL, zero digits total, or more than 10 digits all jump to tlsw_pc_bad. On success returns the decoded u64 in rax; tlsw_pc_bad returns the all-ones sentinel (computed via `xor rax,rax; sub rax,1` rather than a 64-bit immediate load, avoiding any question about imm64 MOV support). Byte loads via xor+mov_b. Pure leaf, no nested calls, no push/pop needed. Labels prefixed tlsw_pc_.",
      block: {
        xor rax, rax;
        mov_b rax, [rdi + 0];
        cmp rax, 0x63;                             // 'c'
        jne tlsw_pc_bad;
        xor rax, rax;
        mov_b rax, [rdi + 1];
        cmp rax, 0x61;                             // 'a'
        jne tlsw_pc_bad;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        cmp rax, 0x70;                             // 'p'
        jne tlsw_pc_bad;
        xor rax, rax;
        mov_b rax, [rdi + 3];
        cmp rax, 0x3a;                             // ':'
        jne tlsw_pc_bad;

        xor r9, r9;                                // acc
        xor r10, r10;                              // digit count
        mov rcx, 4;                                // cursor (past "cap:")
      tlsw_pc_digit_loop:
        xor rax, rax;
        mov_b rax, [rdi + rcx*1];
        cmp rax, 0;
        je tlsw_pc_digit_done;
        sub rax, 48;
        cmp rax, 9;
        ja tlsw_pc_bad;
        mov r8, r9;
        shl r9, 3;
        add r9, r8;
        add r9, r8;                                // acc*10
        add r9, rax;
        add rcx, 1;
        add r10, 1;
        cmp r10, 10;                                // cap at 10 digits
        ja tlsw_pc_bad;
        jmp tlsw_pc_digit_loop;

      tlsw_pc_digit_done:
        cmp r10, 0;                                 // zero digits -> bad
        je tlsw_pc_bad;
        mov rax, r9;
        ret;

      tlsw_pc_bad:
        xor rax, rax;
        sub rax, 1;                                 // all-ones sentinel
        ret
      }
    }

  // -- .bss scratch for the handshake + record-layer functions below. --
  pub let mut tlsw_hs_send_buf  : [u8; 14] = uninit @align(8)
  pub let mut tlsw_hs_recv_buf  : [u8; 64] = uninit @align(8)
  pub let mut tlsw_rec_hdr_buf  : [u8; 5]  = uninit @align(8)

  // ======================================================================
  // net_tls_wrap(sock_fd, trust_cap, hostname_ptr, hostname_len) -> 0 | nz
  //
  // Wave mu-02 (pdxcurl#12) REAL upgrade -- see file header for the
  // full "what this actually lands" explanation. Sends a real 14-byte
  // TLS-record-shaped ClientHello (5-byte record header + a 9-byte
  // minimal ClientHello-shaped handshake body) over sock_fd, then
  // REALLY sys_recv's a response and requires its first byte to be
  // 0x16 (Handshake content type) to report success. trust_cap /
  // hostname_ptr / hostname_len remain unread (no cap-resolution, no
  // SNI -- same scaffold posture as libpdx-net's own net_tls_wrap.pdx).
  // Called from src/main.pdx's Phase C.1.5 immediately after a
  // successful sys_connect on an https:// request that carried a
  // --trust=cap:<n> token.
  // ======================================================================
  pub let tls_wire_net_tls_wrap : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{fs, cap} =
    fn (sock_fd: u64, trust_cap: u64, hostname_ptr: u64, hostname_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs, cap},
      justification: "pdxcurl#12 (Wave mu-02) net_tls_wrap REAL upgrade. 1-push callee-save (rbx=sock_fd) -- entry rsp%16==8, 1 push lands rsp%16==0 (no nested CALL in this leaf, kept for uniformity with remote's 1-push kem_peer_key_fingerprint_hex precedent). trust_cap/hostname_ptr/hostname_len (rsi/rdx/rcx at entry) are never read past this point -- no cap-resolution, no SNI, matching libpdx-net's own net_tls_wrap.pdx scaffold posture (trust_cap accepted-but-unused per that file's own header). Phase 1: composes a fixed 14-byte buffer at tlsw_hs_send_buf via 14 explicit `mov rax,imm; mov_b [r10+N],rax` stores -- bytes [0..4] a TLS record header (content_type=0x16 Handshake, version=0x0301), bytes [5..13] a minimal ClientHello-SHAPED handshake body (handshake_type=0x01, 3-byte length=5, client_version=0x0303, 3 zero filler bytes) -- NOT a spec-conformant ClientHello (no session_id/cipher_suites/extensions -- those need real random/crypto machinery this toolchain does not have yet), but real TLS-record-framed bytes a real TLS stack would at least recognise as a Handshake record. Phase 2: sys_send (SC+92, fd=rbx, buf=&tlsw_hs_send_buf, len=14) -> jl tlsw_ntw_fail. Phase 3: sys_recv (SC+93, fd=rbx, buf=&tlsw_hs_recv_buf, len=64) -> jle tlsw_ntw_fail (this IS the real 'ServerHello wait' the wave asks for -- a genuine blocking network read on the real socket, not a no-op). Phase 4: reads tlsw_hs_recv_buf[0] via xor+mov_b and requires it equal 0x16 (Handshake content type); any other value (a TLS alert 0x15, a non-TLS byte, or the recv failure from Phase 3) falls into tlsw_ntw_fail, returning 1 (nonzero) -- main.pdx's curl_tls_wrap_fail branch is reachable for the first time as of this landing. Success returns 0. No key material is derived anywhere in this function (no crypto intrinsics exist in the paideia-as stdlib to derive it with) -- a 0 return means 'the peer spoke back something TLS-record-shaped', not 'a verified encrypted channel exists'; the request still proceeds in plaintext (see tls_wire_record_send/recv below for the record-layer wrap that DOES now wrap the HTTP bytes, still unencrypted). Encoder discipline: no `test`; no 2-op `imul`; no `and` on r8-r15 with a wide immediate; byte stores via `mov rax,imm; mov_b [ptr],rax`; labels prefixed tlsw_ntw_.",
      block: {
        push rbx;
        mov rbx, rdi;                     // sock_fd

        lea r10, [rip + tlsw_hs_send_buf];
        mov rax, 0x16;
        mov_b [r10 + 0], rax;              // content_type = Handshake
        mov rax, 0x03;
        mov_b [r10 + 1], rax;               // version major
        mov rax, 0x01;
        mov_b [r10 + 2], rax;                // version minor (0x0301)
        mov rax, 0x00;
        mov_b [r10 + 3], rax;                 // record length hi
        mov rax, 0x09;
        mov_b [r10 + 4], rax;                  // record length lo = 9
        mov rax, 0x01;
        mov_b [r10 + 5], rax;                   // handshake_type = ClientHello
        mov rax, 0x00;
        mov_b [r10 + 6], rax;                    // handshake length hi
        mov rax, 0x00;
        mov_b [r10 + 7], rax;                     // handshake length mid
        mov rax, 0x05;
        mov_b [r10 + 8], rax;                      // handshake length lo = 5
        mov rax, 0x03;
        mov_b [r10 + 9], rax;                       // client_version major
        mov rax, 0x03;
        mov_b [r10 + 10], rax;                       // client_version minor
        mov rax, 0x00;
        mov_b [r10 + 11], rax;                        // filler
        mov rax, 0x00;
        mov_b [r10 + 12], rax;                         // filler
        mov rax, 0x00;
        mov_b [r10 + 13], rax;                          // filler

        mov rdi, rbx;
        lea rsi, [rip + tlsw_hs_send_buf];
        mov rdx, 14;
        mov rax, 92;                                      // SC+ sys_send
        syscall;
        cmp rax, 0;
        jl tlsw_ntw_fail;

        mov rdi, rbx;
        lea rsi, [rip + tlsw_hs_recv_buf];
        mov rdx, 64;
        mov rax, 93;                                        // SC+ sys_recv
        syscall;
        cmp rax, 0;
        jle tlsw_ntw_fail;

        xor r9, r9;
        lea r10, [rip + tlsw_hs_recv_buf];
        mov_b r9, [r10 + 0];
        cmp r9, 0x16;                                         // Handshake?
        jne tlsw_ntw_fail;

        pop rbx;
        xor rax, rax;
        ret;

      tlsw_ntw_fail:
        pop rbx;
        mov rax, 1;
        ret
      }
    }

  // ======================================================================
  // tls_wire_record_send(fd, ptr, len) -> 0 | nz     (Wave mu-02, pdxcurl#12)
  //
  // Wraps `len` bytes at `ptr` in a real 5-byte TLS record header
  // (content_type=0x17 Application Data, version=0x0303, 2-byte BE
  // length) and sends header + payload as two real sys_send calls.
  // The payload itself is NOT encrypted (see file header) -- this is
  // record-layer FRAMING only.
  // ======================================================================
  pub let tls_wire_record_send : (u64, u64, u64) -> u64 !{mem, sysreg} @{fs, cap} =
    fn (fd: u64) (ptr: u64) (len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs, cap},
      justification: "pdxcurl#12 (Wave mu-02) tls_wire_record_send. 3-push callee-save (rbx=fd, r12=ptr, r13=len) -- entry rsp%16==8, 3 pushes (24B, odd) land rsp%16==0, no pad needed (no nested CALL, kept for uniformity). Builds the 5-byte header at tlsw_rec_hdr_buf: byte0=0x17 (Application Data), bytes1-2=0x03,0x03 (TLS 1.2 record-layer version, matching TLS 1.3's own record-layer-version-pinning convention), bytes3-4 = len's big-endian 16-bit encoding via `shr rax,8` (hi byte) and `and rax,0xFF` (lo byte -- a SMALL sign-extension-safe immediate, matching remote's kem_hash_to_hex8 precedent). sys_send (SC+92) the 5-byte header -> jl tlsw_rs_fail; sys_send (SC+92) the caller's len-byte payload directly from ptr (r12/r13) -> jl tlsw_rs_fail. Returns 0 on both sends succeeding, 1 otherwise. Does not loop to handle a short sys_send (a single call returning fewer bytes than requested) -- documented known simplification, same class as main.pdx's own single-shot Phase C.3 sys_send for the unwrapped http:// path. Encoder discipline: no `test`; no 2-op `imul`; the one `and` (`and rax,0xFF`) is a small positive immediate; labels prefixed tlsw_rs_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // fd
        mov r12, rsi;                    // ptr
        mov r13, rdx;                    // len

        lea r10, [rip + tlsw_rec_hdr_buf];
        mov rax, 0x17;
        mov_b [r10 + 0], rax;
        mov rax, 0x03;
        mov_b [r10 + 1], rax;
        mov rax, 0x03;
        mov_b [r10 + 2], rax;
        mov rax, r13;
        shr rax, 8;
        mov_b [r10 + 3], rax;
        mov rax, r13;
        and rax, 0xFF;
        mov_b [r10 + 4], rax;

        mov rdi, rbx;
        lea rsi, [rip + tlsw_rec_hdr_buf];
        mov rdx, 5;
        mov rax, 92;                       // SC+ sys_send
        syscall;
        cmp rax, 0;
        jl tlsw_rs_fail;

        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        mov rax, 92;
        syscall;
        cmp rax, 0;
        jl tlsw_rs_fail;

        pop r13;
        pop r12;
        pop rbx;
        xor rax, rax;
        ret;

      tlsw_rs_fail:
        pop r13;
        pop r12;
        pop rbx;
        mov rax, 1;
        ret
      }
    }

  // ======================================================================
  // tls_wire_record_recv(fd, out_ptr, out_cap) -> status  (Wave mu-02,
  //   pdxcurl#12)
  //
  //   status >= 0 -- OK; the value IS the payload byte count (already
  //                  stripped of its 5-byte record header).
  //   status == -1 (all-ones-shaped, via xor+sub) -- a header/payload
  //                  recv failure, a non-Application-Data record, or a
  //                  payload longer than out_cap.
  // ======================================================================
  pub let tls_wire_record_recv : (u64, u64, u64) -> u64 !{mem, sysreg} @{fs, cap} =
    fn (fd: u64) (out_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs, cap},
      justification: "pdxcurl#12 (Wave mu-02) tls_wire_record_recv. 3-push callee-save (rbx=fd, r12=out_ptr, r13=out_cap) -- same odd-push/no-pad arithmetic as tls_wire_record_send. sys_recv (SC+93) exactly 5 bytes into tlsw_rec_hdr_buf; `cmp rax,5; jne tlsw_rr_fail` (single-shot simplification -- a split header read is a documented known gap, not handled). Validates byte0 == 0x17 (Application Data) -> jne tlsw_rr_fail. Decodes the BE16 payload length from bytes[3..4] via `mov_b rax,[hdr+3]; shl rax,8; mov_b r9,[hdr+4]; add rax,r9` into r9, then bounds it against out_cap (`cmp r9,r13; ja tlsw_rr_fail`) so a malicious/malformed length cannot overflow the caller's buffer. sys_recv (SC+93, fd=rbx, buf=out_ptr=r12, len=r9) -> jl tlsw_rr_fail; success returns sys_recv's own byte count verbatim in rax (NOT necessarily equal to r9 -- a short payload read is reported honestly via its real byte count rather than assumed-complete, though the caller does not itself loop to reassemble a split payload read either, same documented simplification as tls_wire_record_send). Failure returns the all-ones-shaped -1 via `xor rax,rax; sub rax,1`. Encoder discipline: no `test`; no 2-op `imul`; byte loads via xor+mov_b; labels prefixed tlsw_rr_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                     // fd
        mov r12, rsi;                     // out_ptr
        mov r13, rdx;                     // out_cap

        mov rdi, rbx;
        lea rsi, [rip + tlsw_rec_hdr_buf];
        mov rdx, 5;
        mov rax, 93;                        // SC+ sys_recv
        syscall;
        cmp rax, 5;
        jne tlsw_rr_fail;

        lea r10, [rip + tlsw_rec_hdr_buf];
        xor r9, r9;
        mov_b r9, [r10 + 0];
        cmp r9, 0x17;                         // Application Data?
        jne tlsw_rr_fail;

        xor rax, rax;
        mov_b rax, [r10 + 3];
        shl rax, 8;
        xor r9, r9;
        mov_b r9, [r10 + 4];
        add rax, r9;
        mov r9, rax;                           // r9 = payload_len

        cmp r9, r13;
        ja tlsw_rr_fail;

        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r9;
        mov rax, 93;
        syscall;
        cmp rax, 0;
        jl tlsw_rr_fail;

        pop r13;
        pop r12;
        pop rbx;
        ret;

      tlsw_rr_fail:
        pop r13;
        pop r12;
        pop rbx;
        xor rax, rax;
        sub rax, 1;
        ret
      }
    }

}
